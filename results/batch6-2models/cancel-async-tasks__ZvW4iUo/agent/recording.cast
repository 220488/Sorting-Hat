[18.262775, "o", "> import asyncio\r\n\u001b[?2004l\r\u001b[?2004h> import signal\r\n\u001b[?2004l\r"]
[18.2655, "o", "\u001b[?2004h> from typing import Callable, Awaitable\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class GracefulInterruptHandler:\r\n\u001b[?2004l\r\u001b[?2004h>     def __init__(self):\r\n\u001b[?2004l\r\u001b[?2004h>         self.interrupted = False\r\n\u001b[?2004l\r\u001b[?2004h>         self.orig_sigint = signal.signal(signal.SIGINT, self._handler)\r\n\u001b[?2004l\r\u001b[?2004h>         self.orig_sigterm = signal.signal(signal.SIGTERM, self._handler)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     def _handler(self, signum, frame):\r\n\u001b[?2004l\r\u001b[?2004h>         self.interrupted = True\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     def __enter__(self):\r\n\u001b[?2004l\r\u001b[?2004h>         return self\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     def __exit__(self, type, value, traceback):\r\n\u001b[?2004l\r\u001b[?2004h>         signal.signal(signal.SIGINT, self.orig_sigint)\r\n\u001b[?2004l\r\u001b[?2004h>         signal.signal(signal.SIGTERM, self.orig_sigterm)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> async def run_tasks(tasks: list[Callable[[], Awaitable[None]]], max_concurrent: int) -> N"]
[18.265585, "o", "one:\r\n\u001b[?2004l\r\u001b[?2004h>     if not tasks:\r\n\u001b[?2004l\r\u001b[?2004h>         return\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Create semaphore to limit concurrent tasks\r\n\u001b[?2004l\r\u001b[?2004h>     semaphore = asyncio.Semaphore(max_concurrent)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     async def run_single_task(task, interrupt_handler):\r\n\u001b[?2004l\r\u001b[?2004h>         async with semaphore:\r\n\u001b[?2004l\r\u001b[?2004h>             # Check if we were interrupted before starting\r\n\u001b[?2004l\r\u001b[?2004h>             if interrupt_handler.interrupted:\r\n\u001b[?2004l\r\u001b[?2004h>                 return\r\n\u001b[?2004l\r\u001b[?2004h>             try:\r\n\u001b[?2004l\r\u001b[?2004h>                 await task()\r\n\u001b[?2004l\r\u001b[?2004h>             except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>                 print(f\"Task failed: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Set up interrupt handling\r\n\u001b[?2004l\r\u001b[?2004h>     with GracefulInterruptHandler() as handler:\r\n\u001b[?2004l\r\u001b[?2004h>         # Create all task coroutines\r\n\u001b[?2004l\r\u001b[?2004h>         task_coro"]
