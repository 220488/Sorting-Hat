[18.265907, "o", "            await asyncio.gather(*task_coroutines, return_exceptions=True)\r\n\u001b[?2004l\r\u001b[?2004h>         except Exception:\r\n\u001b[?2004l\r\u001b[?2004h>             pass  # Handle exceptions gracefully\r\n\u001b[?2004l\r\u001b[?2004h>         finally:\r\n\u001b[?2004l\r\u001b[?2004h> "]
