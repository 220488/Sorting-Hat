[36.665685, "o", "    print(\"Running long tasks with max_concurrent=2. Try pressing Ctrl+C during execution.\")\r\n\u001b[?2004l\r"]
[36.665695, "o", "\u001b[?2004h> "]
[36.665784, "o", "    await run_tasks(tasks, max_concurrent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.665875, "o", "    print(\"All tasks completed or cancelled and cleaned up.\")\r\n\u001b[?2004l\r"]
