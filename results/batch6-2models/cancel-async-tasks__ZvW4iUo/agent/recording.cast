[18.262349, "i", "cat > /app/run.py << 'EOF'\nimport asyncio\nimport signal\nfrom typing import Callable, Awaitable\n\nclass GracefulInterruptHandler:\n    def __init__(self):\n        self.interrupted = False\n        self.orig_sigint = signal.signal(signal.SIGINT, self._handler)\n        self.orig_sigterm = signal.signal(signal.SIGTERM, self._handler)\n    \n    def _handler(self, signum, frame):\n        self.interrupted = True\n    \n    def __enter__(self):\n        return self\n    \n    def __exit__(self, type, value, traceback):\n        signal.signal(signal.SIGINT, self.orig_sigint)\n        signal.signal(signal.SIGTERM, self.orig_sigterm)\n\nasync def run_tasks(tasks: list[Callable[[], Awaitable[None]]], max_concurrent: int) -> None:\n    if not tasks:\n        return\n    \n    # Create semaphore to limit concurrent tasks\n    semaphore = asyncio.Semaphore(max_concurrent)\n    \n    async def run_single_task(task, interrupt_handler):\n        async with semaphore:\n            # Check if we were interrupted before starting\n            if interru"]
[18.262593, "i", "pt_handler.interrupted:\n                return\n            try:\n                await task()\n            except Exception as e:\n                print(f\"Task failed: {e}\")\n    \n    # Set up interrupt handling\n    with GracefulInterruptHandler() as handler:\n        # Create all task coroutines\n        task_coroutines = [run_single_task(task, handler) for task in tasks]\n        \n        try:\n            # Run all tasks concurrently\n            await asyncio.gather(*task_coroutines, return_exceptions=True)\n        except Exception:\n            pass  # Handle exceptions gracefully\n        finally:\n            # If interrupted, give tasks a moment to clean up\n            if handler.interrupted:\n                print(\"Received interrupt signal, allowing tasks to clean up...\")\n                # Small delay to let cleanup code run\n                await asyncio.sleep(0.1)\nEOF\n"]
