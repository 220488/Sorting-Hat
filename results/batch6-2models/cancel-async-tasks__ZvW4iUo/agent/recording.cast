[36.664644, "o", "():\r\n\u001b[?2004l\r\u001b[?2004h>     # Create a list of long-running tasks\r\n\u001b[?2004l\r\u001b[?2004h>     tasks = [\r\n\u001b[?2004l\r\u001b[?2004h>         lambda: long_running_task(1),\r\n\u001b[?2004l\r\u001b[?2004h>         lambda: long_running_task(2),\r\n\u001b[?2004l\r\u001b[?2004h>         lambda: long_running_task(3),\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n\u001b[?2004l\r"]
