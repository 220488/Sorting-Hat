[21.545873, "i", "cat /app/run.py\n"]
[21.546178, "o", "cat /app/run.py\r\n\u001b[?2004l\r"]
[21.54663, "o", "import asyncio\r\nimport signal\r\nfrom typing import Callable, Awaitable\r\n\r\nclass GracefulInterruptHandler:\r\n    def __init__(self):\r\n        self.interrupted = False\r\n        self.orig_sigint = signal.signal(signal.SIGINT, self._handler)\r\n        self.orig_sigterm = signal.signal(signal.SIGTERM, self._handler)\r\n    \r\n    def _handler(self, signum, frame):\r\n        self.interrupted = True\r\n    \r\n    def __enter__(self):\r\n        return self\r\n    \r\n    def __exit__(self, type, value, traceback):\r\n        signal.signal(signal.SIGINT, self.orig_sigint)\r\n        signal.signal(signal.SIGTERM, self.orig_sigterm)\r\n\r\nasync def run_tasks(tasks: list[Callable[[], Awaitable[None]]], max_concurrent: int) -> None:\r\n    if not tasks:\r\n        return\r\n    \r\n    # Create semaphore to limit concurrent tasks\r\n    semaphore = asyncio.Semaphore(max_concurrent)\r\n    \r\n    async def run_single_task(task, interrupt_handler):\r\n        async with semaphore:\r\n            # Check if we were interrupted before starting\r\n            if inte"]
[21.546651, "o", "rrupt_handler.interrupted:\r\n                return\r\n            try:\r\n                await task()\r\n            except Exception as e:\r\n                print(f\"Task failed: {e}\")\r\n    \r\n    # Set up interrupt handling\r\n    with GracefulInterruptHandler() as handler:\r\n        # Create all task coroutines\r\n        task_coroutines = [run_single_task(task, handler) for task in tasks]\r\n        \r\n        try:\r\n            # Run all tasks concurrently\r\n            await asyncio.gather(*task_coroutines, return_exceptions=True)\r\n        except Exception:\r\n            pass  # Handle exceptions gracefully\r\n        finally:\r\n            # If interrupted, give tasks a moment to clean up\r\n            if handler.interrupted:\r\n                print(\"Received interrupt signal, allowing tasks to clean up...\")\r\n                # Small delay to let cleanup code run\r\n                await asyncio.sleep(0.1)\r\n"]
[21.546992, "o", "\u001b[?2004hroot@742a9e52a3a6:/app# "]
[24.723062, "i", "cat > /app/test_run.py << 'EOF'\n#!/usr/bin/env python3\nimport asyncio\nimport time\nfrom run import run_tasks\n\nasync def example_task(task_id, duration):\n    print(f\"Task {task_id} starting\")\n    try:\n        await asyncio.sleep(duration)\n        print(f\"Task {task_id} completed\")\n    except asyncio.CancelledError:\n        print(f\"Task {task_id} was cancelled but cleaning up...\")\n        await asyncio.sleep(0.1)  # Simulate cleanup\n        print(f\"Task {task_id} cleaned up\")\n        raise\n\nasync def main():\n    # Create a list of example tasks with different durations\n    tasks = [\n        lambda: example_task(1, 1),\n        lambda: example_task(2, 2),\n        lambda: example_task(3, 1),\n        lambda: example_task(4, 3),\n        lambda: example_task(5, 1),\n    ]\n    \n    print(\"Running tasks with max_concurrent=2\")\n    start_time = time.time()\n    await run_tasks(tasks, max_concurrent=2)\n    end_time = time.time()\n    print(f\"All tasks completed in {end_time - start_time:.2f} seconds\")\n\nif __name__ == \"__main"]
[24.723198, "o", "cat > /app/test_run.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.723208, "i", "__\":\n    asyncio.run(main())\nEOF\n"]
