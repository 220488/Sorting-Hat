[?2004l[?2004h>     print(f"Task {task_id} starting")
[?2004l[?2004h>     try:
[?2004l[?2004h>         await asyncio.sleep(duration)
[?2004l[?2004h>         print(f"Task {task_id} completed")
[?2004l[?2004h>     except asyncio.CancelledError:
[?2004l[?2004h>         print(f"Task {task_id} was cancelled but cleaning up...")
[?2004l[?2004h>         await asyncio.sleep(0.1)  # Simulate cleanup
[?2004l[?2004h>         print(f"Task {task_id} cleaned up")
[?2004l[?2004h>         raise
[?2004l[?2004h> 
