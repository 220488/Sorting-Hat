[13.24232, "i", "cat > /app/run.py <<'PY'\nimport asyncio\nfrom collections.abc import Awaitable, Callable\n\n\nasync def run_tasks(\n    tasks: list[Callable[[], Awaitable[None]]],\n    max_concurrent: int,\n) -> None:\n    \"\"\"Run async jobs with a limit on the number running concurrently.\n\n    If this function is cancelled, or if one of the jobs raises, all other\n    jobs are cancelled and awaited before the exception is propagated. This\n    gives their cancellation handlers and ``finally`` blocks a chance to run.\n    \"\"\"\n    if max_concurrent <= 0:\n        raise ValueError(\"max_concurrent must be greater than zero\")\n\n    semaphore = asyncio.Semaphore(max_concurrent)\n\n    async def run_one(task: Callable[[], Awaitable[None]]) -> None:\n        async with semaphore:\n            await task()\n\n    pending = [asyncio.create_task(run_one(task)) for task in tasks]\n    if not pending:\n        return\n\n    try:\n        await asyncio.gather(*pending)\n    except BaseException:\n        for task in pending:\n            if not task.done():\n       "]
[13.242506, "o", "cat > /app/run.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[13.242606, "i", "         task.cancel()\n        await asyncio.gather(*pending, return_exceptions=True)\n        raise\nPY\npython3 -m py_compile /app/run.py\nsed -n '1,240p' /app/run.py\n"]
