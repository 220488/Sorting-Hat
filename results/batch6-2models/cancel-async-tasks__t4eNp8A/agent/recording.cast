[13.362566, "o", "import asyncio\r\nfrom collections.abc import Awaitable, Callable\r\n\r\n\r\nasync def run_tasks(\r\n    tasks: list[Callable[[], Awaitable[None]]],\r\n    max_concurrent: int,\r\n) -> None:\r\n    \"\"\"Run async jobs with a limit on the number running concurrently.\r\n\r\n    If this function is cancelled, or if one of the jobs raises, all other\r\n    jobs are cancelled and awaited before the exception is propagated. This\r\n    gives their cancellation handlers and ``finally`` blocks a chance to run.\r\n    \"\"\"\r\n    if max_concurrent <= 0:\r\n        raise ValueError(\"max_concurrent must be greater than zero\")\r\n\r\n    semaphore = asyncio.Semaphore(max_concurrent)\r\n\r\n    async def run_one(task: Callable[[], Awaitable[None]]) -> None:\r\n        async with semaphore:\r\n            await task()\r\n\r\n    pending = [asyncio.create_task(run_one(task)) for task in tasks]\r\n    if not pending:\r\n        return\r\n\r\n    try:\r\n        await asyncio.gather(*pending)\r\n    except BaseException:\r\n        for task in pending:\r\n            if not task.done():\r\n"]
[13.362583, "o", "                task.cancel()\r\n        await asyncio.gather(*pending, return_exceptions=True)\r\n        raise\r\n\u001b[?2004hroot@09b0dd21a84e:/app# "]
[22.028532, "i", "python3 - <<'PY'\nimport asyncio\nfrom run import run_tasks\n\nasync def main():\n    active = 0\n    maximum = 0\n    cleaned = 0\n    lock = asyncio.Lock()\n\n    async def job():\n        nonlocal active, maximum, cleaned\n        async with lock:\n            active += 1\n            maximum = max(maximum, active)\n        try:\n            await asyncio.sleep(0.2)\n        finally:\n            async with lock:\n                active -= 1\n                cleaned += 1\n\n    await run_tasks([job for _ in range(5)], 2)\n    assert maximum == 2, maximum\n    assert cleaned == 5, cleaned\n\n    cleaned = 0\n    runner = asyncio.create_task(run_tasks([job for _ in range(5)], 2))\n    await asyncio.sleep(0.05)\n    runner.cancel()\n    try:\n        await runner\n    except asyncio.CancelledError:\n        pass\n    assert cleaned == 5, cleaned\n\nasyncio.run(main())\nprint('behavioral tests passed')\nPY"]
