[?2004limport asyncio
from collections.abc import Awaitable, Callable


async def run_tasks(
    tasks: list[Callable[[], Awaitable[None]]],
    max_concurrent: int,
) -> None:
    """Run async jobs with a limit on the number running concurrently.

    If this function is cancelled, or if one of the jobs raises, all other
    jobs are cancelled and awaited before the exception is propagated. This
    gives their cancellation handlers and ``finally`` blocks a chance to run.
    """
    if max_concurrent <= 0:
        raise ValueError("max_concurrent must be greater than zero")

    semaphore = asyncio.Semaphore(max_concurrent)

    async def run_one(task: Callable[[], Awaitable[None]]) -> None:
        async with semaphore:
            await task()

    pending = [asyncio.create_task(run_one(task)) for task in tasks]
    if not pending:
        return

    try:
        await asyncio.gather(*pending)
    except BaseException:
        for task in pending:
            if not task.done():
                task.cancel()
        await asyncio.gather(*pending, return_exceptions=True)
        raise
