[?2004l[?2004h> async def main():
[?2004l[?2004h>     active = 0
[?2004l[?2004h>     maximum = 0
[?2004l[?2004h>     cleaned = 0
[?2004l[?2004h>     lock = asyncio.Lock()
[?2004l[?2004h> 
[?2004l[?2004h>     async def job():
[?2004l[?2004h>         nonlocal active, maximum, cleaned
[?2004l[?2004h>         async with lock:
[?2004l[?2004h>             active += 1
[?2004l[?2004h>             maximum = max(maximum, active)
[?2004l[?2004h>         try:
[?2004l[?2004h>             await asyncio.sleep(0.2)
[?2004l[?2004h>         finally:
[?2004l[?2004h>             async with lock:
[?2004l[?2004h>                 active -= 1
[?2004l[?2004h>                 cleaned += 1
[?2004l[?2004h> 
[?2004l[?2004h>     await run_tasks([job for _ in range(5)], 2)
[?2004l[?2004h>     assert maximum == 2, maximum
[?2004l[?2004h>     assert cleaned == 5, cleaned
[?2004l[?2004h> 
[?2004l[?2004h>     cleaned = 0
[?2004l[?2004h>     runner = asyncio.create_task(run_tasks([job for _ in range(5)], 2))
[?2004l[?2004h>     await asyncio.sleep(0.05)
[?2004l[?2004h>     runner.cancel()
[?2004l[?2004h>     try:
[?2004l[?2004h>         await runner
[?2004l[?2004h>     except asyncio.CancelledError:
[?2004l[?2004h>         pass
[?2004l[?2004h>     assert cleaned == 5, cleaned
