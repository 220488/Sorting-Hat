[51.051725, "i", "echo '--- Python run ---'; python3 /app/program.py; echo '--- comparisons ---'; status=0; for f in ACCOUNTS.DAT BOOKS.DAT TRANSACTIONS.DAT; do if cmp -s \"/app/data/$f\" \"/tmp/compare/cobol/data/$f\"; then echo \"$f: IDENTICAL\"; else echo \"$f: DIFFERENT\"; status=1; cmp -l \"/app/data/$f\" \"/tmp/compare/cobol/data/$f\" | head; fi; done; echo '--- hashes ---'; sha256sum /app/data/*.DAT /tmp/compare/cobol/data/*.DAT; exit $status\n"]
