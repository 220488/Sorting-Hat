[42.020565, "i", "cat > /app/program.py <<'PY'\n#!/usr/bin/env python3\nimport os\n\nBASE = \"/app\"\nDATA = os.path.join(BASE, \"data\")\nSRC = os.path.join(BASE, \"src\")\n\nACCOUNT_SIZE = 34\nBOOK_SIZE = 28\nTRANSACTION_SIZE = 22\nINPUT_SIZE = 22\n\n\ndef fixed_records(data, size):\n    \"\"\"Yield fixed-size records, including a final short record if present.\"\"\"\n    return [data[pos:pos + size] for pos in range(0, len(data), size)]\n\n\ndef field(record, start, length):\n    return record[start:start + length]\n\n\ndef main():\n    input_path = os.path.join(SRC, \"INPUT.DAT\")\n    with open(input_path, \"rb\") as f:\n        input_record = f.read(INPUT_SIZE)\n\n    if not input_record:\n        print(\"Error: Input file is empty\")\n        return\n\n    input_record = input_record.ljust(INPUT_SIZE, b\" \")\n    buyer = field(input_record, 0, 4)\n    seller = field(input_record, 4, 4)\n    book_id = field(input_record, 8, 4)\n    amount_bytes = field(input_record, 12, 10)\n\n    # PIC 9(10) input is an unsigned, zero-padded decimal integer.\n    amount_text = amount_bytes.dec"]
[42.020736, "i", "ode(\"ascii\", errors=\"strict\").strip()\n    amount = int(amount_text or \"0\")\n\n    accounts_path = os.path.join(DATA, \"ACCOUNTS.DAT\")\n    books_path = os.path.join(DATA, \"BOOKS.DAT\")\n    transactions_path = os.path.join(DATA, \"TRANSACTIONS.DAT\")\n\n    with open(accounts_path, \"rb\") as f:\n        accounts_data = f.read()\n    with open(books_path, \"rb\") as f:\n        books_data = f.read()\n\n    accounts = fixed_records(accounts_data, ACCOUNT_SIZE)\n    books = fixed_records(books_data, BOOK_SIZE)\n\n    buyer_found = any(len(r) >= 4 and field(r, 0, 4) == buyer for r in accounts)\n    seller_found = any(len(r) >= 4 and field(r, 0, 4) == seller for r in accounts)\n\n    book_found = False\n    valid_owner = False\n    for record in books:\n        if len(record) >= BOOK_SIZE and field(record, 0, 4) == book_id:\n            book_found = True\n            if field(record, 24, 4) == seller:\n                valid_owner = True\n\n    if not (buyer_found and seller_found and book_found and valid_owner):\n        print(\"Transaction failed"]
[42.020751, "o", "cat > /app/program.py <<'PY'\r\n\u001b[?2004l\r"]
[42.020764, "i", " due to validation errors\")\n        return\n\n    # REWRITE changes only the current fixed-width record.  Retain any\n    # unexpected trailing bytes exactly as they were.\n    updated_accounts = []\n    for record in accounts:\n        if len(record) < ACCOUNT_SIZE:\n            updated_accounts.append(record)\n            continue\n        account_id = field(record, 0, 4)\n        if account_id == buyer or account_id == seller:\n            balance_text = field(record, 24, 10).decode(\"ascii\")\n            balance = int(balance_text)\n            if account_id == buyer:\n                balance -= amount\n            if account_id == seller:\n                balance += amount\n            record = record[:24] + f\"{balance:010d}\".encode(\"ascii\") + record[34:]\n        updated_accounts.append(record)\n\n    updated_books = []\n    for record in books:\n        if len(record) >= BOOK_SIZE and field(record, 0, 4) == book_id:\n            record = record[:24] + buyer + record[28:]\n        updated_books.append(record)\n\n    with open(acc"]
[42.02077, "i", "ounts_path, \"wb\") as f:\n        f.write(b\"\".join(updated_accounts))\n    with open(books_path, \"wb\") as f:\n        f.write(b\"\".join(updated_books))\n\n    transaction = book_id + f\"{amount:010d}\".encode(\"ascii\") + seller + buyer\n    with open(transactions_path, \"ab\") as f:\n        f.write(transaction)\n\n    print(\"Transaction completed successfully\")\n\n\nif __name__ == \"__main__\":\n    main()\nPY\nchmod +x /app/program.py\npython3 -m py_compile /app/program.py\n"]
[42.020905, "o", "ode(\"ascii\", errors=\"strict\").strip()\r\n    amount = int(amount_text or \"0\")\r\n\r\n    accounts_path = os.path.join(DATA, \"ACCOUNTS.DAT\")\r\n    books_path = os.path.join(DATA, \"BOOKS.DAT\")\r\n    transactions_path = os.path.join(DATA, \"TRANSACTIONS.DAT\")\r\n\r\n    with open(accounts_path, \"rb\") as f:\r\n        accounts_data = f.read()\r\n    with open(books_path, \"rb\") as f:\r\n        books_data = f.read()\r\n\r\n    accounts = fixed_records(accounts_data, ACCOUNT_SIZE)\r\n    books = fixed_records(books_data, BOOK_SIZE)\r\n\r\n    buyer_found = any(len(r) >= 4 and field(r, 0, 4) == buyer for r in accounts)\r\n    seller_found = any(len(r) >= 4 and field(r, 0, 4) == seller for r in accounts)\r\n\r\n    book_found = False\r\n    valid_owner = False\r\n    for record in books:\r\n  "]
[42.020978, "o", "      if len(record) >= BOOK_SIZE and field(record, 0, 4) == book_id:\r\n            book_found = True\r\n            if field(record, 24, 4) == seller:\r\n                valid_owner = True\r\n\r\n    if not (buyer_found and seller_found and book_found and valid_owner):\r\n        print(\"Transaction failed due to validation errors\")\r\n        return\r\n\r\n    # REWRITE changes only the current fixed-width record.  Retain any\r\n    # unexpected trailing bytes exactly as they were.\r\n    updated_accounts = []\r\n    for record in accounts:\r\n        if len(record) < ACCOUNT_SIZE:\r\n            updated_accounts.append(record)\r\n            continue\r\n        account_id = field(record, 0, 4)\r\n        if account_id == buyer or account_id == seller:\r\n            balance_text = field(record, 24, 10).decode(\"ascii\")\r\n            balance = int(balance_text)\r\n            if account_id == buyer:\r\n                balance -= amount\r\n            if account_id == seller:\r\n                balance += amount\r\n            record = record[:24] + f\"{ba"]
