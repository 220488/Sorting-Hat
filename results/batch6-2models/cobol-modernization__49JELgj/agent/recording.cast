[5.433561, "i", "pwd; printf '\\n--- files ---\\n'; find /app -maxdepth 3 -type f -printf '%p\\n' | sort; printf '\\n--- COBOL source ---\\n'; sed -n '1,260p' /app/src/program.cbl; printf '\\n--- INPUT.DAT ---\\n'; if [ -f /app/src/INPUT.DAT ]; then od -An -tx1c /app/src/INPUT.DAT; fi; printf '\\n--- data metadata ---\\n'; ls -l /app/data 2>/dev/null || true\n"]
[5.434159, "o", "pwd; printf '\\n--- files ---\\n'; find /app -maxdepth 3 -type f -printf '%p\\n' | sort; printf '\\n--- COBOL source ---\\n'; sed -n '1,260p' /app/src/program.cbl; printf '\\n--- INPUT.DAT ---\\n'; if [ -f /app/src/INPUT.DAT ]; then od -An -tx1c /app/src/INPUT.DAT; fi; printf '\\n--- data metadata ---\\n'; ls -l /app/data 2>/dev/null || true\r\n\u001b[?2004l\r"]
