[159.783437, "i", "cat > apsw_recovery.py << 'EOF'\n#!/usr/bin/env python3\n\nimport apsw\n\ntry:\n    # Try opening with flags that might help with recovery\n    db = apsw.Connection(\"main.db\", flags=apsw.SQLITE_OPEN_READWRITE | apsw.SQLITE_OPEN_CREATE)\n    cursor = db.cursor()\n    \n    # Try to query all records\n    print(\"Attempting to read all records...\")\n    cursor.execute(\"SELECT * FROM items ORDER BY id\")\n    records = cursor.fetchall()\n    print(f\"Found {len(records)} records:\")\n    for record in records:\n        print(record)\n        \n    db.close()\nexcept Exception as e:\n    print(f\"Error: {e}\")\n    \n# Also try with read-only mode\ntry:\n    print(\"\\nTrying read-only mode...\")\n    db = apsw.Connection(\"main.db\", flags=apsw.SQLITE_OPEN_READONLY)\n    cursor = db.cursor()\n    cursor.execute(\"SELECT * FROM items ORDER BY id\")\n    records = cursor.fetchall()\n    print(f\"Found {len(records)} records in read-only mode:\")\n    for record in records:\n        print(record)\n    db.close()\nexcept Exception as e:\n    print(f\"Read-only error: {e}\")\nEOF\n"]
[159.783751, "o", "cat > apsw_recovery.py << 'EOF'\r\n"]
