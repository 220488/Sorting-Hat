[144.356449, "o", "\u001b[01;31m\u001b[Kpython\u001b[m\u001b[K-aiosqlite-doc - sqlite library for Python 3 using asyncio (documentation)\r\n\u001b[01;31m\u001b[Kpython\u001b[m\u001b[K3-aiosqlite - sqlite library for Python 3 using asyncio\r\n\u001b[01;31m\u001b[Kpython\u001b[m\u001b[K3-apsw - another Python SQLite 3 wrapper (Python 3 version)\r\n\u001b[01;31m\u001b[Kpython\u001b[m\u001b[K3-bottle-sqlite - SQLite3 integration for Bottle - Python 3.x\r\n\u001b[01;31m\u001b[Kpython\u001b[m\u001b[K3-minidb - simple SQLite3-based store for Python objects\r\n\u001b[01;31m\u001b[Kpython\u001b[m\u001b[K3-peewee - Simple ORM for PostgreSQL, MySQL and SQLite (Python 3)\r\n\u001b[01;31m\u001b[Kpython\u001b[m\u001b[K3-sqlite-fts4 - Document scoring Python library for SQLite FTS4\r\n\u001b[01;31m\u001b[Kpython\u001b[m\u001b[K3-sqlitedict - Persistent dict in Python, backed up by sqlite3 and pickle, multithread-safe\r\n"]
