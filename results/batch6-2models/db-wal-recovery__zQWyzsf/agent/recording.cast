[102.962915, "i", "cat > recover.c << 'EOF'\n#include <stdio.h>\n#include <sqlite3.h>\n\nint main() {\n    sqlite3 *src_db, *dest_db;\n    sqlite3_backup *backup;\n    int rc;\n    \n    // Open source database\n    rc = sqlite3_open(\"main.db\", &src_db);\n    if (rc != SQLITE_OK) {\n        fprintf(stderr, \"Can't open source database: %s\\n\", sqlite3_errmsg(src_db));\n        sqlite3_close(src_db);\n        return 1;\n    }\n    \n    // Open destination database\n    rc = sqlite3_open(\"recovered.db\", &dest_db);\n    if (rc != SQLITE_OK) {\n        fprintf(stderr, \"Can't open destination database: %s\\n\", sqlite3_errmsg(dest_db));\n        sqlite3_close(src_db);\n        sqlite3_close(dest_db);\n        return 1;\n    }\n    \n    // Perform backup\n    backup = sqlite3_backup_init(dest_db, \"main\", src_db, \"main\");\n    if (backup) {\n        sqlite3_backup_step(backup, -1);\n        sqlite3_backup_finish(backup);\n    }\n    \n    rc = sqlite3_errcode(dest_db);\n    \n    sqlite3_close(src_db);\n    sqlite3_close(dest_db);\n    \n    if (rc == SQLITE_OK) {\n        printf(\"Database recovery completed successfully.\\n\");\n        return 0;\n    } else {\n        fprintf(stderr, \"Database recovery failed: %s\\n\", sqlite3_errstr(rc));\n        return 1;\n    }\n}\nEOF\n"]
