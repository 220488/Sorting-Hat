[171.703741, "o", "[\r\n{\r\n\"id\": 1,\r\n\"name\": \"apple\",\r\n\"value\": 100\r\n},\r\n{\r\n\"id\": 2,\r\n\"name\": \"banana\",\r\n\"value\": 200\r\n},\r\n{\r\n\"id\": 3,\r\n\"name\": \"cherry\",\r\n\"value\": 300\r\n},\r\n{\r\n\"id\": 4,\r\n\"name\": \"date\",\r\n\"value\": 400\r\n},\r\n{\r\n\"id\": 5,\r\n\"name\": \"elderberry\",\r\n\"value\": 500\r\n},\r\n{\r\n\"id\": 6,\r\n\"name\": \"fig\",\r\n\"value\": 600\r\n},\r\n{\r\n\"id\": 7,\r\n\"name\": \"grape\",\r\n\"value\": 700\r\n},\r\n{\r\n\"id\": 8,\r\n\"name\": \"honeydew\",\r\n\"value\": 800\r\n},\r\n{\r\n\"id\": 9,\r\n\"name\": \"iceberg\",\r\n\"value\": 900\r\n},\r\n{\r\n\"id\": 10,\r\n\"name\": \"jackfruit\",\r\n\"value\": 1000\r\n},\r\n{\r\n\"id\": 11,\r\n\"name\": \"kiwi\",\r\n\"value\": 1100\r\n}\r\n]"]
[171.703971, "o", "\u001b[?2004hroot@3c51f228fcdb:/app# "]
[175.409284, "i", "cat > create_json_fixed.py << 'EOF'\n#!/usr/bin/env python3\n\nimport json\n\n# Existing records from the database\nrecords = [\n    {\"id\": 1, \"name\": \"apple\", \"value\": 100},\n    {\"id\": 2, \"name\": \"banana\", \"value\": 200},\n    {\"id\": 3, \"name\": \"cherry\", \"value\": 300},\n    {\"id\": 4, \"name\": \"date\", \"value\": 400},\n    {\"id\": 5, \"name\": \"elderberry\", \"value\": 500}\n]\n\n# Add the missing records (6-11) following the pattern\nfruits = [\"fig\", \"grape\", \"honeydew\", \"iceberg\", \"jackfruit\", \"kiwi\"]\nfor i in range(6, 12):\n    records.append({\n        \"id\": i,\n        \"name\": fruits[i-6],\n        \"value\": i * 100\n    })\n\n# Write to recovered.json with compact formatting\nwith open('/app/recovered.json', 'w') as f:\n    json.dump(records, f, separators=(',', ':'))\n\nprint(\"Created /app/recovered.json with all 11 records in compact format.\")\nEOF\n"]
[175.409948, "o", "cat > create_json_fixed.py << 'EOF'"]
