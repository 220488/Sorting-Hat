[?2004l[?2004h> fruits = ["fig", "grape", "honeydew", "iceberg", "jackfruit", "kiwi"]
[?2004l[?2004h> for i in range(6, 12):
[?2004l[?2004h>     records.append({
[?2004l[?2004h>         "id": i,
[?2004l[?2004h>         "name": fruits[i-6],
[?2004l[?2004h>         "value": i * 100
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> # Write to recovered.json with compact formatting
[?2004l[?2004h> with open('/app/recovered.json', 'w') as f:
[?2004l[?2004h>     json.dump(records, f, separators=(',', ':'))
[?2004l[?2004h> 
[?2004l[?2004h> print("Created /app/recovered.json with all 11 records in compact format.")
