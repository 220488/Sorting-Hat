[46.545504, "o", "\u001b[?2004h> "]
[46.545566, "o", "  ?workedDepartment uni:belongsTo ?workedUniversity .\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.545582, "o", "> "]
