[12.112609, "o", "uni:AI101\r\nuni:Aristotle_Tympas\r\nuni:Athanasios_Voulodimos\r\nuni:Berkeley\r\nuni:Bio10\r\nuni:Bio101\r\nuni:Biology_MIT\r\nuni:CS101\r\nuni:ComputerScience_NTUA\r\nuni:Course\r\nuni:Department\r\nuni:ETHZurich\r\nuni:Eng202\r\nuni:EngUS302\r\nuni:Engineering_Berkeley\r\nuni:Engineering_LMU\r\nuni:HistoryAndPhilosophy_NKUA\r\nuni:IST\r\nuni:John_Smith\r\nuni:LMU\r\nuni:MIT\r\nuni:Marie_Dubois\r\nuni:Math101\r\nuni:Math201\r\nuni:Mathematics_IST\r\nuni:Mathematics_Sorbonne\r\nuni:MechEngineering_NTUA\r\nuni:NKUA\r\nuni:NTUA\r\nuni:Orfeas_Menis\r\nuni:Pepe_Attanasio\r\nuni:Person\r\nuni:Physics301\r\nuni:Physics_ETH\r\nuni:Robotics_UPM\r\nuni:STS101\r\nuni:Sloan_MIT\r\nuni:Sorbonne\r\nuni:Stefan_Mueller\r\nuni:Student1\r\nuni:Student10\r\nuni:Student11\r\nuni:Student12\r\n"]
