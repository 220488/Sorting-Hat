[46.545314, "o", "      \"DE\" \"GR\" \"HU\" \"IE\" \"IT\" \"LV\" \"LT\" \"LU\" \"MT\" \"NL\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.545332, "o", "      \"PL\" \"PT\" \"RO\" \"SK\" \"SI\" \"ES\" \"SE\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.54541, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
