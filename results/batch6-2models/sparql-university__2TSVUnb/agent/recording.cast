[46.544306, "o", "  # The professor must work in at least one EU-country department."]
[46.544666, "o", "\r\n\u001b[?2004l\r"]
[46.544729, "o", "\u001b[?2004h>   FILTER EXISTS {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.544792, "o", "    ?professor uni:worksIn ?euDepartment .\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.544808, "o", "> "]
