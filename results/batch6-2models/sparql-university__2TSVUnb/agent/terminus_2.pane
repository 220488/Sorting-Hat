[?2004hroot@c3eb1405cb64:/app# cat > /app/solution.sparql <<'EOF'
[?2004l[?2004h> PREFIX uni: <http://university.org/ontology/>
[?2004l[?2004h> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
[?2004l[?2004h> 
[?2004l[?2004h> # Reference date: 2025-08-16
[?2004l[?2004h> SELECT ?professorName
[?2004l[?2004h>        (GROUP_CONCAT(DISTINCT ?country; separator=", ") AS ?countries)
[?2004l[?2004h> WHERE {
[?2004l[?2004h>   # Full professors only; this excludes Assistant Professor roles.
[?2004l[?2004h>   ?professor a uni:Person ;
[?2004l[?2004h>              uni:hasName ?professorName ;
