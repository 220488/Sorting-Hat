[35.749143, "o", "cat /app/solution.sparql\r\n\u001b[?2004l\r"]
[35.750019, "o", "PREFIX uni: <http://university.org/ontology/>\r\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\r\n\r\nSELECT ?professorName (GROUP_CONCAT(DISTINCT ?country; separator=\", \") AS ?countries)\r\nWHERE {\r\n  # Find professors (not assistant professors)\r\n  ?professor a uni:Person ;\r\n             uni:hasName ?professorName ;\r\n             uni:role ?role ;\r\n             uni:worksIn ?department .\r\n  \r\n  FILTER(CONTAINS(?role, \"Professor\") && !CONTAINS(?role, \"Assistant\"))\r\n  \r\n  # Link department to university and get country\r\n  ?department uni:belongsTo ?university .\r\n  ?university uni:locatedInCountry ?country .\r\n  \r\n  # EU countries as of 2025\r\n  VALUES ?euCountries { \"AT\" \"BE\" \"BG\" \"CY\" \"CZ\" \"DE\" \"DK\" \"EE\" \"ES\" \"FI\" \"FR\" \"GR\" \"HR\" \"HU\" \"IE\" \"IT\" \"LT\" \"LU\" \"LV\" \"MT\" \"NL\" \"PL\" \"PT\" \"RO\" \"SE\" \"SI\" \"SK\" }\r\n  FILTER(?country IN (?euCountries))\r\n}\r\nGROUP BY ?professor ?professorName\r\n# Having clause to ensure at least one department with >10 active students\r\nHAVING EXISTS {\r\n  SELECT ?professor (COUNT(DISTINCT ?student) AS ?studentCount)\r\n  WHERE {\r\n    ?professor uni:worksIn ?dept .\r\n    \r\n    # Find courses taught by professors in this department\r\n    ?profInDept uni:worksIn ?dept ;\r\n               uni:teaches ?course .\r\n    \r\n    # Find students enrolled in those courses\r\n    ?student uni:isEnrolledIn ?course ;\r\n            uni:hasEnrollmentDate ?enrollmentDate .\r\n    \r\n    # Check if student hasn't graduated or will graduate after reference date\r\n    OPTIONAL { ?student uni:hasGraduationDate ?graduationDate }\r\n    FILTER(!BOUND(?graduationDate) || ?graduationDate > \"2025-08-16\"^^xsd:date)\r\n    FILTER(?enrollmentDate <= \"2025-08-16\"^^xsd:date)\r\n  }\r\n  GROUP BY ?professor ?dept\r\n  HAVING (?studentCount > 10)\r\n}\r\nC-c\r\nls -l solution.sparql\r\ncat > /app/solution.sparql << 'EOF'\r\nPREFIX uni: <http://university.org/ontology/>\r\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\r\n\r\nSELECT ?professorName (GROUP_CONCAT(DISTINCT ?country; separator=\", \") AS ?countries)\r\nWHERE {\r\n  # Find full professors (exclude assistants)\r\n  ?professor a uni:Person ;\r\n             uni:hasName ?professorName ;\r\n             uni:role ?role ;\r\n             uni:worksIn ?department .\r\n  \r\n  FILTER(CONTAINS(?role, \"Professor\") && !CONTAINS(?role, \"Assistant\"))\r\n  \r\n  # Link department to university and get country\r\n  ?department uni:belongsTo ?university .\r\n  ?university uni:locatedInCountry ?country .\r\n  \r\n  # Filter for EU countries as of 2025\r\n  VALUES ?euCountry { \r\n    \"AT\" \"BE\" \"BG\" \"CY\" \"CZ\" \"DE\" \"DK\" \"EE\" \"ES\" \"FI\" \"FR\" \r\n    \"GR\" \"HR\" \"HU\" \"IE\" \"IT\" \"LT\" \"LU\" \"LV\" \"MT\" \"NL\" \"PL\" \r\n    \"PT\" \"RO\" \"SE\" \"SI\" \"SK\"\r\n  }\r\n  FILTER(?country IN (?euCountry))\r\n}\r\nGROUP BY ?professor ?professorName\r\n# Ensure at least one department has >10 active students\r\nHAVING EXISTS {\r\n  SELECT ?professor (COUNT(DISTINCT ?student) AS ?studentCount)\r\n  WHERE {\r\n    # Get departments where this professor works\r\n    ?professor uni:worksIn ?dept .\r\n    \r\n    # Find courses taught by any professor in this department\r\n    ?anyProf uni:worksIn ?dept ;\r\n             uni:teaches ?course .\r\n    \r\n    # Find students enrolled in these courses\r\n    ?student uni:isEnrolledIn ?course ;\r\n             uni:hasEnrollmentDate ?enrollmentDate .\r\n    FILTER(?enrollmentDate <= \"2025-08-16\"^^xsd:date)\r\n    \r\n    # Check if student is still active (no graduation date or graduation after reference)\r\n    OPTIONAL { ?student uni:hasGraduationDate ?graduationDate }\r\n    FILTER(!BOUND(?graduationDate) || ?graduationDate > \"2025-08-16\"^^xsd:date)\r\n  }\r\n  GROUP BY ?professor ?dept\r\n  HAVING (?studentCount > 10)\r\n}\r\n"]
[35.750066, "o", "\u001b[?2004hroot@4b5d1841850e:/app# "]
[41.893895, "i", "cat > /app/solution.sparql << 'ENDOFQUERY'\nPREFIX uni: <http://university.org/ontology/>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n\nSELECT ?professorName (GROUP_CONCAT(DISTINCT ?country; separator=\", \") AS ?countries)\nWHERE {\n  # Find full professors (excluding assistants)\n  ?professor a uni:Person ;\n             uni:hasName ?professorName ;\n             uni:role ?role ;\n             uni:worksIn ?department .\n  \n  FILTER(CONTAINS(?role, \"Professor\") && !CONTAINS(?role, \"Assistant\"))\n  \n  # Link department to university and get country\n  ?department uni:belongsTo ?university .\n  ?university uni:locatedInCountry ?country .\n  \n  # Filter for EU countries as of 2025 (complete list)\n  VALUES ?euCountry { \n    \"AT\" \"BE\" \"BG\" \"CY\" \"CZ\" \"DE\" \"DK\" \"EE\" \"ES\" \"FI\" \"FR\" \n    \"GR\" \"HR\" \"HU\" \"IE\" \"IT\" \"LT\" \"LU\" \"LV\" \"MT\" \"NL\" \"PL\" \n    \"PT\" \"RO\" \"SE\" \"SI\" \"SK\"\n  }\n  FILTER(?country IN (?euCountry))\n}\nGROUP BY ?professor ?professorName\n# Ensure at least one department has >10 active students\nHAVING EXISTS {\n  SELECT ?professor (COUNT(DISTINCT ?student) AS ?studentCount)\n  WHERE {\n    # Get any department where this professor works\n    ?professor uni:worksIn ?dept .\n    \n    # Find courses taught by any professor in this department\n    ?anyProf uni:worksIn ?dept ;\n             uni:teaches ?course .\n    \n    # Find students enrolled in these courses who are still active\n    ?student uni:isEnrolledIn ?course ;\n             uni:hasEnrollmentDate ?enrollmentDate .\n    FILTER(?enrollmentDate <= \"2025-08-16\"^^xsd:date)\n    \n    # Check if student hasn't graduated or will graduate after reference date\n    OPTIONAL { ?student uni:hasGraduationDate ?graduationDate }\n    FILTER(!BOUND(?graduationDate) || ?graduationDate > \"2025-08-16\"^^xsd:date)\n  }\n  GROUP BY ?professor ?dept\n  HAVING (?studentCount > 10)\n}\nENDOFQUERY\n"]
[41.894119, "o", "cat > /app/solution.sparql << 'ENDOFQUERY'\r\n"]
