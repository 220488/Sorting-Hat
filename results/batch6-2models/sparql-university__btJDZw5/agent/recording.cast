[32.750651, "o", "  SELECT ?professor (COUNT(DISTINCT ?student) AS ?studentCount)\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.750719, "o", ">   WHERE {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.750791, "o", "    # Get departments where this professor works\r\n\u001b[?2004l\r"]
[32.750809, "o", "\u001b[?2004h> "]
[32.751611, "o", "    ?professor uni:worksIn ?dept .\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Find courses taught by any professor in this department\r\n\u001b[?2004l\r\u001b[?2004h>     ?anyProf uni:worksIn ?dept ;\r\n\u001b[?2004l\r\u001b[?2004h>              uni:teaches ?course .\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Find students enrolled in these courses\r\n\u001b[?2004l\r\u001b[?2004h>     ?student uni:isEnrolledIn ?course ;\r\n\u001b[?2004l\r\u001b[?2004h>              uni:hasEnrollmentDate ?enrollmentDate .\r\n\u001b[?2004l\r\u001b[?2004h>     FILTER(?enrollmentDate <= \"2025-08-16\"^^xsd:date)\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.751721, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.75182, "o", "    # Check if student is still active (no graduation date or graduation after reference)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.751839, "o", "    OPTIONAL { ?student uni:hasGraduationDate ?graduationDate }\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.751851, "o", "> "]
[32.751974, "o", "    FILTER(!BOUND(?graduationDate) || ?graduationDate > \"2025-08-16\"^^xsd:date)\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.751992, "o", ">   }\r\n"]
[32.752015, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[32.752186, "o", "  GROUP BY ?professor ?dept\r\n\u001b[?2004l\r\u001b[?2004h>   HAVING (?studentCount > 10)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
