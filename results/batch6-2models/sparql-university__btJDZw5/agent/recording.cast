[22.94124, "i", "cat > /app/solution.sparql << 'EOF'\nPREFIX uni: <http://university.org/ontology/>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n\nSELECT ?professorName (GROUP_CONCAT(DISTINCT ?country; separator=\", \") AS ?countries)\nWHERE {\n  # Find professors (not assistant professors)\n  ?professor a uni:Person ;\n             uni:hasName ?professorName ;\n             uni:role ?role ;\n             uni:worksIn ?department .\n  \n  FILTER(CONTAINS(?role, \"Professor\") && !CONTAINS(?role, \"Assistant\"))\n  \n  # Link department to university and get country\n  ?department uni:belongsTo ?university .\n  ?university uni:locatedInCountry ?country .\n  \n  # EU countries as of 2025\n  VALUES ?euCountries { \"AT\" \"BE\" \"BG\" \"CY\" \"CZ\" \"DE\" \"DK\" \"EE\" \"ES\" \"FI\" \"FR\" \"GR\" \"HR\" \"HU\" \"IE\" \"IT\" \"LT\" \"LU\" \"LV\" \"MT\" \"NL\" \"PL\" \"PT\" \"RO\" \"SE\" \"SI\" \"SK\" }\n  FILTER(?country IN (?euCountries))\n}\nGROUP BY ?professor ?professorName\n# Having clause to ensure at least one department with >10 active students\nHAVING EXISTS {\n  SELECT ?professor (COUNT(DISTINCT ?student) AS ?studentCount)\n  WHERE {\n    ?professor uni:worksIn ?dept .\n    \n    # Find courses taught by professors in this department\n    ?profInDept uni:worksIn ?dept ;\n               uni:teaches ?course .\n    \n    # Find students enrolled in those courses\n    ?student uni:isEnrolledIn ?course ;\n            uni:hasEnrollmentDate ?enrollmentDate .\n    \n    # Check if student hasn't graduated or will graduate after reference date\n    OPTIONAL { ?student uni:hasGraduationDate ?graduationDate }\n    FILTER(!BOUND(?graduationDate) || ?graduationDate > \"2025-08-16\"^^xsd:date)\n    FILTER(?enrollmentDate <= \"2025-08-16\"^^xsd:date)\n  }\n  GROUP BY ?professor ?dept\n  HAVING (?studentCount > 10)\n}\n"]
[22.941578, "o", "cat > /app/solution.sparql << 'EOF'\r\n\u001b[?2004l\r"]
[22.942671, "o", "\u001b[?2004h"]
[22.94321, "o", "> PREFIX uni: <http://university.org/ontology/>\r\n\u001b[?2004l\r\u001b[?2004h> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> SELECT ?professorName (GROUP_CONCAT(DISTINCT ?country; separator=\", \") AS ?countries)\r\n\u001b[?2004l\r\u001b[?2004h> WHERE {\r\n\u001b[?2004l\r\u001b[?2004h>   # Find professors (not assistant professors)\r\n\u001b[?2004l\r\u001b[?2004h>   ?professor a uni:Person ;\r\n\u001b[?2004l\r\u001b[?2004h>              uni:hasName ?professorName ;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.944416, "o", "             uni:role ?role ;\r\n\u001b[?2004l\r\u001b[?2004h>              uni:worksIn ?department .\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   FILTER(CONTAINS(?role, \"Professor\") && !CONTAINS(?role, \"Assistant\"))\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   # Link department to university and get country\r\n\u001b[?2004l\r\u001b[?2004h>   ?department uni:belongsTo ?university .\r\n\u001b[?2004l\r\u001b[?2004h>   ?university uni:locatedInCountry ?country .\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   # EU countries as of 2025\r\n\u001b[?2004l\r\u001b[?2004h>   VALUES ?euCountries { \"AT\" \"BE\" \"BG\" \"CY\" \"CZ\" \"DE\" \"DK\" \"EE\" \"ES\" \"FI\" \"FR\" \"GR\" \"HR\" \"HU\" \"IE\" \"IT\" \"LT\" \"LU\" \"LV\" \"MT\" \"NL\" \"PL\" \"PT\" \"RO\" \"SE\" \"SI\" \"SK\" }\r\n\u001b[?2004l\r\u001b[?2004h>   FILTER(?country IN (?euCountries))\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> GROUP BY ?professor ?professorName\r\n\u001b[?2004l\r\u001b[?2004h> # Having clause to ensure at least one department with >10 active students\r\n\u001b[?2004l\r\u001b[?2004h> HAVING EXISTS {\r\n\u001b[?2004l\r\u001b[?2004h>   SELECT ?professor (COUNT(DISTINCT ?student) AS ?studentCount)\r\n\u001b[?2004l\r\u001b[?2004h>   WHERE {\r\n\u001b[?2004l\r\u001b[?2004h>     ?professor uni:worksIn ?dept .\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Find courses taught by professors in this department\r\n\u001b[?2004l\r\u001b[?2004h>     ?profInDept uni:worksIn ?dept ;\r\n\u001b[?2004l\r\u001b[?2004h>                uni:teaches ?course .\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Find students enrolled in those courses\r\n\u001b[?2004l\r\u001b[?2004h>     ?student uni:isEnrolledIn ?course ;\r\n\u001b[?2004l\r\u001b[?2004h>             uni:hasEnrollmentDate ?enrollmentDate .\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Check if student hasn't graduated or will graduate after reference date\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.945405, "o", "    OPTIONAL { ?student uni:hasGraduationDate ?graduationDate }\r\n\u001b[?2004l\r\u001b[?2004h>     FILTER(!BOUND(?graduationDate) || ?graduationDate > \"2025-08-16\"^^xsd:date)\r\n\u001b[?2004l\r\u001b[?2004h>     FILTER(?enrollmentDate <= \"2025-08-16\"^^xsd:date)\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   GROUP BY ?professor ?dept\r\n\u001b[?2004l\r\u001b[?2004h>   HAVING (?studentCount > 10)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
