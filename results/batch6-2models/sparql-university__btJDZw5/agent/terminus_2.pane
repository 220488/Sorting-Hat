ls -l solution.sparql
cat > /app/solution.sparql << 'EOF'
PREFIX uni: <http://university.org/ontology/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?professorName (GROUP_CONCAT(DISTINCT ?country; separator=", ") AS ?countries)
WHERE {
  # Find full professors (exclude assistants)
  ?professor a uni:Person ;
             uni:hasName ?professorName ;
             uni:role ?role ;
             uni:worksIn ?department .
  
  FILTER(CONTAINS(?role, "Professor") && !CONTAINS(?role, "Assistant"))
  
  # Link department to university and get country
  ?department uni:belongsTo ?university .
  ?university uni:locatedInCountry ?country .
  
  # Filter for EU countries as of 2025
  VALUES ?euCountry { 
    "AT" "BE" "BG" "CY" "CZ" "DE" "DK" "EE" "ES" "FI" "FR" 
    "GR" "HR" "HU" "IE" "IT" "LT" "LU" "LV" "MT" "NL" "PL" 
    "PT" "RO" "SE" "SI" "SK"
  }
  FILTER(?country IN (?euCountry))
}
GROUP BY ?professor ?professorName
# Ensure at least one department has >10 active students
HAVING EXISTS {
  SELECT ?professor (COUNT(DISTINCT ?student) AS ?studentCount)
  WHERE {
    # Get departments where this professor works
    ?professor uni:worksIn ?dept .
    
    # Find courses taught by any professor in this department
    ?anyProf uni:worksIn ?dept ;
             uni:teaches ?course .
    
    # Find students enrolled in these courses
    ?student uni:isEnrolledIn ?course ;
             uni:hasEnrollmentDate ?enrollmentDate .
    FILTER(?enrollmentDate <= "2025-08-16"^^xsd:date)
    
    # Check if student is still active (no graduation date or graduation after reference)
    OPTIONAL { ?student uni:hasGraduationDate ?graduationDate }
    FILTER(!BOUND(?graduationDate) || ?graduationDate > "2025-08-16"^^xsd:date)
  }
  GROUP BY ?professor ?dept
  HAVING (?studentCount > 10)
}
