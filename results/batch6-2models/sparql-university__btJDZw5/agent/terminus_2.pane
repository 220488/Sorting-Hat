[?2004luni:locatedInCountry "CH"
uni:locatedInCountry "DE"
uni:locatedInCountry "ES"
uni:locatedInCountry "FR"
uni:locatedInCountry "GR"
uni:locatedInCountry "PT"
uni:locatedInCountry "US"
[?2004hroot@4b5d1841850e:/app# cat > /app/solution.sparql << 'EOF'
[?2004l[?2004h> PREFIX uni: <http://university.org/ontology/>
[?2004l[?2004h> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
[?2004l[?2004h> 
[?2004l[?2004h> SELECT ?professorName (GROUP_CONCAT(DISTINCT ?country; separator=", ") AS ?countries)
[?2004l[?2004h> WHERE {
[?2004l[?2004h>   # Find professors (not assistant professors)
[?2004l[?2004h>   ?professor a uni:Person ;
[?2004l[?2004h>              uni:hasName ?professorName ;
[?2004l[?2004h>              uni:role ?role ;
[?2004l[?2004h>              uni:worksIn ?department .
[?2004l[?2004h>   
[?2004l[?2004h>   FILTER(CONTAINS(?role, "Professor") && !CONTAINS(?role, "Assistant"))
[?2004l[?2004h>   
[?2004l[?2004h>   # Link department to university and get country
[?2004l[?2004h>   ?department uni:belongsTo ?university .
[?2004l[?2004h>   ?university uni:locatedInCountry ?country .
[?2004l[?2004h>   
[?2004l[?2004h>   # EU countries as of 2025
[?2004l[?2004h>   VALUES ?euCountries { "AT" "BE" "BG" "CY" "CZ" "DE" "DK" "EE" "ES" "FI" "FR" "GR" "HR" "HU" "IE" "IT" "LT" "LU" "LV" "MT" "NL" "PL" "PT" "RO" "SE" "SI" "SK" }
[?2004l[?2004h>   FILTER(?country IN (?euCountries))
[?2004l[?2004h> }
[?2004l[?2004h> GROUP BY ?professor ?professorName
[?2004l[?2004h> # Having clause to ensure at least one department with >10 active students
[?2004l[?2004h> HAVING EXISTS {
[?2004l[?2004h>   SELECT ?professor (COUNT(DISTINCT ?student) AS ?studentCount)
[?2004l[?2004h>   WHERE {
[?2004l[?2004h>     ?professor uni:worksIn ?dept .
[?2004l[?2004h>     
[?2004l[?2004h>     # Find courses taught by professors in this department
[?2004l[?2004h>     ?profInDept uni:worksIn ?dept ;
[?2004l[?2004h>                uni:teaches ?course .
[?2004l[?2004h>     
[?2004l[?2004h>     # Find students enrolled in those courses
[?2004l[?2004h>     ?student uni:isEnrolledIn ?course ;
[?2004l[?2004h>             uni:hasEnrollmentDate ?enrollmentDate .
[?2004l[?2004h>     
[?2004l[?2004h>     # Check if student hasn't graduated or will graduate after reference date
[?2004l[?2004h>     OPTIONAL { ?student uni:hasGraduationDate ?graduationDate }
[?2004l[?2004h>     FILTER(!BOUND(?graduationDate) || ?graduationDate > "2025-08-16"^^xsd:date)
[?2004l[?2004h>     FILTER(?enrollmentDate <= "2025-08-16"^^xsd:date)
[?2004l[?2004h>   }
[?2004l[?2004h>   GROUP BY ?professor ?dept
[?2004l[?2004h>   HAVING (?studentCount > 10)
[?2004l[?2004h> }
[?2004l[?2004h> C-c
[?2004l[?2004h> ls -l solution.sparql
[?2004l[?2004h> cat > /app/solution.sparql << 'EOF'
[?2004l[?2004h> PREFIX uni: <http://university.org/ontology/>
[?2004l[?2004h> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
[?2004l[?2004h> 
[?2004l[?2004h> SELECT ?professorName (GROUP_CONCAT(DISTINCT ?country; separator=", ") AS ?countries)
[?2004l[?2004h> WHERE {
[?2004l[?2004h>   # Find full professors (exclude assistants)
[?2004l[?2004h>   ?professor a uni:Person ;
[?2004l[?2004h>              uni:hasName ?professorName ;
[?2004l[?2004h>              uni:role ?role ;
[?2004l[?2004h>              uni:worksIn ?department .
[?2004l[?2004h>   
[?2004l[?2004h>   FILTER(CONTAINS(?role, "Professor") && !CONTAINS(?role, "Assistant"))
[?2004l[?2004h>   
[?2004l[?2004h>   # Link department to university and get country
[?2004l[?2004h>   ?department uni:belongsTo ?university .
[?2004l[?2004h>   ?university uni:locatedInCountry ?country .
[?2004l[?2004h>   
[?2004l[?2004h>   # Filter for EU countries as of 2025
[?2004l[?2004h>   VALUES ?euCountry { 
[?2004l[?2004h>     "AT" "BE" "BG" "CY" "CZ" "DE" "DK" "EE" "ES" "FI" "FR" 
[?2004l[?2004h>     "GR" "HR" "HU" "IE" "IT" "LT" "LU" "LV" "MT" "NL" "PL" 
[?2004l[?2004h>     "PT" "RO" "SE" "SI" "SK"
[?2004l[?2004h>   }
[?2004l[?2004h>   FILTER(?country IN (?euCountry))
[?2004l[?2004h> }
[?2004l[?2004h> GROUP BY ?professor ?professorName
[?2004l[?2004h> # Ensure at least one department has >10 active students
[?2004l[?2004h> HAVING EXISTS {
[?2004l[?2004h>   SELECT ?professor (COUNT(DISTINCT ?student) AS ?studentCount)
[?2004l[?2004h>   WHERE {
[?2004l[?2004h>     # Get departments where this professor works
[?2004l[?2004h>     ?professor uni:worksIn ?dept .
[?2004l[?2004h>     
[?2004l[?2004h>     # Find courses taught by any professor in this department
[?2004l[?2004h>     ?anyProf uni:worksIn ?dept ;
[?2004l[?2004h>              uni:teaches ?course .
[?2004l[?2004h>     
[?2004l[?2004h>     # Find students enrolled in these courses
[?2004l[?2004h>     ?student uni:isEnrolledIn ?course ;
[?2004l[?2004h>              uni:hasEnrollmentDate ?enrollmentDate .
[?2004l[?2004h>     FILTER(?enrollmentDate <= "2025-08-16"^^xsd:date)
[?2004l[?2004h>     
[?2004l[?2004h>     # Check if student is still active (no graduation date or graduation after reference)
[?2004l[?2004h>     OPTIONAL { ?student uni:hasGraduationDate ?graduationDate }
[?2004l[?2004h>     FILTER(!BOUND(?graduationDate) || ?graduationDate > "2025-08-16"^^xsd:date)
[?2004l[?2004h>   }
[?2004l[?2004h>   GROUP BY ?professor ?dept
[?2004l[?2004h>   HAVING (?studentCount > 10)
[?2004l[?2004h> }
[?2004l[?2004h> EOF
[?2004l[?2004hroot@4b5d1841850e:/app# cat /app/solution.sparql
[?2004lPREFIX uni: <http://university.org/ontology/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?professorName (GROUP_CONCAT(DISTINCT ?country; separator=", ") AS ?countries)
WHERE {
  # Find professors (not assistant professors)
  ?professor a uni:Person ;
             uni:hasName ?professorName ;
             uni:role ?role ;
             uni:worksIn ?department .
  
  FILTER(CONTAINS(?role, "Professor") && !CONTAINS(?role, "Assistant"))
  
  # Link department to university and get country
  ?department uni:belongsTo ?university .
  ?university uni:locatedInCountry ?country .
  
  # EU countries as of 2025
  VALUES ?euCountries { "AT" "BE" "BG" "CY" "CZ" "DE" "DK" "EE" "ES" "FI" "FR" "GR" "HR" "HU" "IE" "IT" "LT" "LU" "LV" "MT" "NL" "PL" "PT" "RO" "SE" "SI" "SK" }
  FILTER(?country IN (?euCountries))
}
GROUP BY ?professor ?professorName
# Having clause to ensure at least one department with >10 active students
HAVING EXISTS {
  SELECT ?professor (COUNT(DISTINCT ?student) AS ?studentCount)
  WHERE {
    ?professor uni:worksIn ?dept .
    
    # Find courses taught by professors in this department
    ?profInDept uni:worksIn ?dept ;
               uni:teaches ?course .
    
    # Find students enrolled in those courses
    ?student uni:isEnrolledIn ?course ;
            uni:hasEnrollmentDate ?enrollmentDate .
    
    # Check if student hasn't graduated or will graduate after reference date
    OPTIONAL { ?student uni:hasGraduationDate ?graduationDate }
    FILTER(!BOUND(?graduationDate) || ?graduationDate > "2025-08-16"^^xsd:date)
    FILTER(?enrollmentDate <= "2025-08-16"^^xsd:date)
  }
  GROUP BY ?professor ?dept
  HAVING (?studentCount > 10)
}
