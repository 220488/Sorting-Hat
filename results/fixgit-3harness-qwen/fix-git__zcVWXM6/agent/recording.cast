[60.755054, "o", "\u001b[1mdiff --git a/_layouts/default.html b/_layouts/default.html\u001b[m\u001b[m\r\n\u001b[1mindex 3fe07ee..cff5b5e 100644\u001b[m\u001b[m\r\n\u001b[1m--- a/_layouts/default.html\u001b[m\u001b[m\r\n\u001b[1m+++ b/_layouts/default.html\u001b[m\u001b[m\r\n\u001b[36m@@ -27,7 +27,9 @@\u001b[m\u001b[m\r\n     <link href=\"css/bootstrap.min.css\" rel=\"stylesheet\">\u001b[m\u001b[m\r\n     <link href=\"css/style.css\" rel=\"stylesheet\">\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n\u001b[31m-    <link href=\"https://fonts.googleapis.com/css?family=Noto+Sans+HK:100,300|Barlow+Condensed|PT+Mono|PT+Serif&display=swap\" rel=\"stylesheet\">\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    <link\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        href=\"https://fonts.googleapis.com/css?family=Noto+Sans+HK:100,300|Barlow+Condensed|PT+Mono|PT+Serif&display=swap\"\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        rel=\"stylesheet\">\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n </head>\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n\u001b[36m@@ -38,7 +40,7 @@\u001b[m\u001b[m\r\n             <div class=\"jumbotron\">\u001b[m\u001b[m\r\n                 <div class=\"row\">\u001b[m\u001b[m\r\n                     <h3>\u001b[m\u001b[m\r\n\u001b[31m-                        PhD Student @ UW CSE\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                        Postdoc @ Stanfor"]
