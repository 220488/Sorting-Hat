[25.074772, "o", "import asyncio\r\nfrom typing import Callable, Awaitable, List\r\n\r\ndef run_tasks(tasks: List[Callable[[], Awaitable[None]]], max_concurrent: int) -> None:\r\n    \"\"\"\r\n    Run multiple async tasks concurrently with a maximum number of concurrent executions.\r\n    \r\n    Args:\r\n        tasks: List of async functions to run (each returns an Awaitable[None])\r\n        max_concurrent: Maximum number of tasks to run concurrently\r\n    \"\"\"\r\n    async def run_single_task(task: Callable[[], Awaitable[None]]) -> None:\r\n        try:\r\n            await task()\r\n        except asyncio.CancelledError:\r\n            # Propagate cancellation but don't suppress cleanup\r\n            raise\r\n    \r\n    semaphore = asyncio.Semaphore(max_concurrent)\r\n    \r\n    async def safe_task(task: Callable[[], Awaitable[None]]) -> None:\r\n        async with semaphore:\r\n            await run_single_task(task)\r\n    \r\n    async def run_all():\r\n        try:\r\n            await asyncio.gather(*[safe_task(task) for task in tasks], return_exceptions=True)\r\n      "]
[25.075004, "o", "  finally:\r\n            # Ensure semaphore is released\r\n            semaphore.release()\r\n    \r\n    # Run the tasks, handling keyboard interrupts gracefully\r\n    async def cancel_and_wait():\r\n        tasks_to_cancel = [safe_task(task) for task in tasks]\r\n        for task in tasks_to_cancel:\r\n            task.cancel()\r\n        await asyncio.gather(*tasks_to_cancel, return_exceptions=True)\r\n    \r\n    loop = asyncio.get_event_loop()\r\n    try:\r\n        loop.run_until_complete(run_all())\r\n    except KeyboardInterrupt:\r\n        # Cancel all tasks on keyboard interrupt, allowing cleanup to run\r\n        loop.run_until_complete(cancel_and_wait())\r\n    finally:\r\n        # Ensure semaphore is released if tasks were cancelled\r\n        semaphore.release()\r\n"]
