[?2004limport asyncio
from concurrent.futures import Semaphore
from typing import Callable, Awaitable, List

def run_tasks(tasks: List[Callable[[], Awaitable[None]]], max_concurrent: int) -> None:
    """
    Run multiple async tasks concurrently with a maximum number of concurrent executions.
    
    Args:
        tasks: List of async functions to run (each returns an Awaitable[None])
        max_concurrent: Maximum number of tasks to run concurrently
    """
    async def run_single_task(task: Callable[[], Awaitable[None]]) -> None:
        try:
            await task()
        except asyncio.CancelledError:
            # Propagate cancellation but don't suppress cleanup
            raise
    
    semaphore = Semaphore(max_concurrent)
    semaphore.acquire()  # Pre-fill to ensure we can limit properly
    semaphore.release()  # Immediately release
    
    async def safe_task(task: Callable[[], Awaitable[None]]) -> None:
        async with semaphore:
            await run_single_task(task)
    
    async def run_all():
        try:
            await asyncio.gather(*[safe_task(task) for task in tasks], return_exceptions=True)
        finally:
            semaphore.release()  # If tasks fail due to semaphores, release them
    
    # Run the tasks, handling keyboard interrupts gracefully
    loop = asyncio.get_event_loop()
    try:
        loop.run_until_complete(run_all())
    except KeyboardInterrupt:
        # Cancel all tasks on keyboard interrupt, allowing cleanup to run
        tasks_to_cancel = [safe_task(task) for task in tasks]
        for task in tasks_to_cancel:
            task.cancel()
        await asyncio.gather(*tasks_to_cancel, return_exceptions=True)
    finally:
        # Ensure semaphore is released if tasks were cancelled
        semaphore.release()
