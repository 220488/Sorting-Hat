[?2004lller_found = True

    # Read BOOKS.DAT
    with open(books_file, 'r') as f:
        for line in f:
            record = line.strip()
            book_id_in_file = record[0:4]
            book_owner = record[24:28]
            if book_id_in_file == book_id:
                book_found = True
                if book_owner == seller_id:
                    valid_owner = True
            
    # Validate and process
    if buyer_found and seller_found and book_found and valid_owner:
        # Process ACCOUNTS.DAT - update balances
        lines = []
        with open(accounts_file, 'r') as f:
            for line in f:
                record = line.strip()
                account_id = record[0:4]
                if account_id == buyer_id:
                    balance = int(record[24:34])
                    new_balance = balance - amount
                    new_record = record[:24] + f"{new_balance:010d}"
                    lines.append(new_record)
                elif account_id == seller_id:
                    balance = int(record[24:34])
                    new_balance = balance + amount
                    new_record = record[:24] + f"{new_balance:010d}"
                    lines.append(new_record)
                else:
                    lines.append(record)

        with open(accounts_file, 'w') as f:
            for line in lines:
                f.write(line + '\n')

        # Process BOOKS.DAT - update ownership
        lines = []
        with open(books_file, 'r') as f:
            for line in f:
                record = line.strip()
                book_id_in_file = record[0:4]
                if book_id_in_file == book_id:
                    # Update owner
                    new_record = record[:24] + buyer_id
                    lines.append(new_record)
                else:
                    lines.append(record)

        with open(books_file, 'w') as f:
            for line in lines:
                f.write(line + '\n')

        # Append to TRANSACTIONS.DAT
        with open(transactions_file, 'a') as f:
            trans_record = book_id + f"{amount:010d}" + seller_id + buyer_id
            f.write(trans_record + '\n')

        print("Transaction completed successfully")
    else:
        print("Transaction failed due to validation errors")

if __name__ == '__main__':
    main()
