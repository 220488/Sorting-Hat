    seller_id = input_data[4:8]
    book_id = input_data[8:12]
    amount_str = input_data[12:22]
    amount = int(amount_str)

    # Validate users and books
    buyer_found = False
    seller_found = False
    book_found = False
    valid_owner = False

    # Read ACCOUNTS.DAT
    with open(accounts_file, 'r') as f:
        for line in f:
            record = line.strip()
            account_id = record[0:4]
            if account_id == buyer_id:
                buyer_found = True
            if account_id == seller_id:
                seller_found = True

    # Read BOOKS.DAT
    with open(books_file, 'r') as f:
        for line in f:
            record = line.strip()
            book_id_in_file = record[0:4]
            book_owner = record[24:28]
            if book_id_in_file == book_id:
                book_found = True
                if book_owner == seller_id:
                    valid_owner = True
            
    # Validate and process
    if buyer_found and seller_found and book_found and valid_owner:
        # Process ACCOUNTS.DAT - update balances
