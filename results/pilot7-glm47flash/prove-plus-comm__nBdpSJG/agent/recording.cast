[729.635261, "i", "cat > plus_comm.v << 'ENDFILE'\nRequire Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros n m.\n  apply nat_ind\n    with (m := m).\n  - reflexivity.\n  - intros n IH. simpl.\n    intros m. apply IH\nQed.\nENDFILE\n"]
