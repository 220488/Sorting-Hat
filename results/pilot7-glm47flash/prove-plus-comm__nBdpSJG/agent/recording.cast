[242.173581, "i", "cat > plus_comm.v << 'EOF'\nRequire Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros n m.\n  case n.\n  - intros m.\n    simpl.\n    rewrite Nat.add_0_l.\n    rewrite Nat.add_0_r.\n    reflexivity.\n  - intros n' m' IH. simpl.\n    rewrite Nat.add_0_r.\n    apply IH\nQed.\nEOF\ncoqc plus_comm.v\n"]
[242.173836, "o", "cat > plus_comm.v << 'EOF'\r\n\u001b[?2004l\r"]
