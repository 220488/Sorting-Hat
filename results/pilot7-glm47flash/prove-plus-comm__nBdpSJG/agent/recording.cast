[84.654478, "o", "Require Import Arith.\r\n\r\nTheorem plus_comm : forall n m : nat,\r\n  n + m = m + n.\r\nProof.\r\n  intros n m.\r\n  destruct n.\r\n  - simpl.\r\n    rewrite Nat.add_0_r.\r\n    reflexivity.\r\n  - simpl.\r\n    rewrite Nat.add_0_r.\r\n    apply nf.\r\nQed.\r\n"]
