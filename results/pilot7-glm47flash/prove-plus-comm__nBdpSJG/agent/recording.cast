[261.282265, "i", "cat > plus_comm.v << 'EOF'\nRequire Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros x y.\n  apply nat_rect\n    with (P := fun m => x + m = m + x).\n  - simpl. apply eq_refl.\n  - intros m IH x2. simpl.\n    rewrite Nat.add_0_r.\n    apply IH\nQed.\nEOF\ncoqc plus_comm.v\n"]
