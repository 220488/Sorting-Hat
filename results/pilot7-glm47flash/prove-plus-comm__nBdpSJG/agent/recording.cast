[398.867178, "o", "Require Import Arith.\r\n\r\nTheorem plus_comm : forall n m : nat,\r\n  n + m = m + n.\r\nProof.\r\n  intros n m.\r\n  induction n as [|n IHn].\r\n  - simpl.\r\n    symmetry.\r\n    apply Nat.add_0_r.\r\n    reflexivity.\r\n  - simpl.\r\n    assumption\r\nQed.\r\n"]
[398.867552, "o", "\u001b[?2004hroot@54939701b0dc:/workspace# "]
