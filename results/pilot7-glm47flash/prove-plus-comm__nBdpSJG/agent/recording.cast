[888.745286, "i", "printf 'Require Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros n m.\n  generalize dependent m.\n  induction n.\n  - intros m. simpl. reflexivity.\n  - intros m IH. simpl. symmetry. apply IH\nQed.' > plus_comm.v\n"]
[888.745543, "o", "printf 'Require Import Arith."]
