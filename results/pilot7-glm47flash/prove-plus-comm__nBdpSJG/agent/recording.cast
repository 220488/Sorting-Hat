[215.26356, "i", "cat > plus_comm.v << 'EOF'\nRequire Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros n m.\n  apply nat_rect\n    with (P := fun m => S (n + m) = m + S n).  \n  - simpl.\n    apply eq_refl.\n  - simpl.\n    apply Nat.add_0_m.\nQed.\nEOF\ncoqc plus_comm.v\n"]
[215.263948, "o", "cat > plus_comm.v << 'EOF'\r\n\u001b[?2004l\r"]
[215.263992, "o", "\u001b[?2004h"]
