[275.668298, "i", "cat > debug.v << 'EOF'\nFrom Coq Require Import Arith.\n\nGoal forall x y : nat, x + y = y + x.\nintros x y.\napply nat_rect\n  with (P := fun m => x + m = m + x).\n- intros m. simpl.\n  unfold m in *.\n  no print.\nQed.\nEOF\ncoqc debug.v\n"]
[275.668451, "o", "cat > debug.v << 'EOF'\r\n"]
