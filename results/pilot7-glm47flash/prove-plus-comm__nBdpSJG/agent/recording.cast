[451.250966, "i", "cat > plus_comm.v << 'ENDOFFILE'\nRequire Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros n m.\n  apply nat_ind\n    with (m := m).\n  - intros m. simpl. reflexivity.\n  - intros n m IH. simpl.\n    apply IH\nQed.\nENDOFFILE\n"]
[451.25131, "o", "cat > plus_comm.v << 'ENDOFFILE'\r\n"]
