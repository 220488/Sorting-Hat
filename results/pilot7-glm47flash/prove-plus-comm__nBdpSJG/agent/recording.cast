[218.034965, "i", "cat > plus_comm.v << 'EOF'\nRequire Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros n m.\n  induction n as [|n IHn].\n  - case.\n    intros m.\n    simpl.\n    rewrite Nat.add_0_l.\n    rewrite Nat.add_0_r.\n    reflexivity.\n  - simpl.\n    intros m\nQed.\nEOF\ncoqc plus_comm.v\n"]
[218.035313, "o", "cat > plus_comm.v << 'EOF'\r\n\u001b[?2004l\r"]
