[802.042826, "i", "printf 'Require Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros n m.\n  intros n.\n  apply nat_rect\n    with (fun pp => n + pp = pp + n).\n  - reflexivity.\n  - intros pp IH.\n    intros m.\n    apply nat_rect\n      with (fun pp2 => S n + pp2 = pp2 + S n).\n    - reflexivity.\n    - apply IH\nQed.' > plus_comm.v\n"]
[802.042982, "o", "printf 'Require Import Arith.\r\n"]
