[437.885332, "i", "cat > plus_comm.v << 'EOF'\nRequire Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros x y.\n  apply nat_rect\n    with (P := fun m => x + m = m + x).\n  - intros m. simpl. reflexivity.\n  - intros m IH x2. simpl.\n    symmetry.\n    apply IH\nQed.\nEOF\ncoqc plus_comm.v\n"]
[437.885706, "o", "cat > plus_comm.v << 'EOF'\r\n\u001b[?2004l\r"]
