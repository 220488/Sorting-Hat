[45.830206, "i", "cat > plus_comm.v << 'EOF'\nRequire Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros n m.\n  induction n as [|n IHn].\n  - simpl.\n    rewrite Nat.add_0_r.\n    reflexivity.\n  - simpl.\n    rewrite Nat.add_assoc with (m:=m) (n:=n) (p:=0) in *.\n    rewrite Nat.add_0_l.\n    apply IHn.\nQed.\nEOF\n"]
[45.830441, "o", "cat > plus_comm.v << 'EOF'"]
