[892.829409, "i", "printf 'Require Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros n m.\n  induction n as [|n IHn].\n  - intros m. simpl. exact (Nat.add_0_r m). assumptions\n  - intros m. simpl. apply IHn\nQed.' > plus_comm.v\n"]
[892.829588, "o", "printf 'Require Import Arith.\r\n\u001b[?2004l\r"]
