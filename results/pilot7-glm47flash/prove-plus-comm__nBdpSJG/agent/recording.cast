[108.180061, "i", "cat > plus_comm.v << 'EOF'\nRequire Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros n m.\n  induction n as [|n IHn].\n  - simpl.\n    rewrite Nat.add_0_r.\n    reflexivity.\n  - simpl.\n    symmetry.\n    rewrite plus_n_Sm.\n    apply IHn.\nQed.\nEOF\n"]
