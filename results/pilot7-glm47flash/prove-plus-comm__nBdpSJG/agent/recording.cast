[220.404606, "i", "cat > plus_comm.v << 'EOF'\nRequire Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros n m.\n  induction n.\n  - intros m.\n    simpl.\n    rewrite Nat.add_0_l.\n    rewrite Nat.add_0_r.\n    reflexivity.\n  - intros n m IH. simpl.\n    apply eq_refl.\n    assumption.\nQed.\nEOF\ncoqc plus_comm.v\n"]
[220.405398, "o", "cat > plus_comm.v << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> Require Import Arith.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> Theorem plus_comm : forall n m : nat,\r\n\u001b[?2004l\r\u001b[?2004h>   n + m = m + n.\r\n\u001b[?2004l\r\u001b[?2004h> Proof.\r\n\u001b[?2004l\r\u001b[?2004h>   intros n m.\r\n\u001b[?2004l\r\u001b[?2004h>   induction n.\r\n\u001b[?2004l\r\u001b[?2004h>   - intros m.\r\n\u001b[?2004l\r\u001b[?2004h>     simpl.\r\n\u001b[?2004l\r\u001b[?2004h>     rewrite Nat.add_0_l.\r\n\u001b[?2004l\r\u001b[?2004h>     rewrite Nat.add_0_r.\r\n\u001b[?2004l\r\u001b[?2004h> "]
