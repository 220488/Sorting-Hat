[813.547235, "i", "cat > plus_comm.v << 'ENDFILE'\nRequire Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros x y.\n  induction x.\n  - simpl. reflexivity.\n  - simpl. exact (Nat.add_0_l m). exact (Nat.add_0_r m). reflexivity\nQed.\nENDFILE\n"]
