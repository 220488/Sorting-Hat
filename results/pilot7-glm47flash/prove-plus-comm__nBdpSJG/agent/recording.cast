[193.802485, "i", "cat > debug_rewrite.v << 'EOF'\nFrom Coq Require Import Arith.\n\nGoal forall n m : nat, n + m = m + n.\nintros n m.\nrefine (nat_rect _ _ _ _ n).\n- intros m simpl.\n  rewrite Nat.add_0_r.\n  reflexivity.\n- intros n m IH simpl.\n  apply IH.\nQed.\nEOF\ncoqc debug_rewrite.v\n"]
