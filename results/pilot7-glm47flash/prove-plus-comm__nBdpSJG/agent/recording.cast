[774.72769, "i", "printf 'Require Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros n m.\n  induction n as [|n IHn].\n  - case.\n    intros m simpl.\n    symmetry. \n    apply Nat.add_0_r. \n    reflexivity.\n  - case. \n    intros m simpl. \n    apply IHn\nQed.' > plus_comm.v\n"]
[774.727951, "o", "printf 'Require Import Arith.\r\n\u001b[?2004l\r"]
