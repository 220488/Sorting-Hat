[278.179895, "i", "cat > plus_comm.v << 'EOF'\nRequire Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros n m.\n  induction n as [|n IHn].\n  - simpl.\n    reflexivity\n    || exact (Nat.add_0_r m).\n  - simpl.\n    reflexivity\n    || apply IHn\nEOF\ncoqc plus_comm.v\n"]
[278.180286, "o", "cat > plus_comm.v << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> Require Import Arith.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
