[462.569706, "i", "cat > plus_comm.v << 'ENDOFFILE'\nRequire Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros n m.\n  induction n.\n  - intros m. simpl. reflexivity.\n  - clear m. intros m. apply IHn.\nQed.\nENDOFFILE\n"]
