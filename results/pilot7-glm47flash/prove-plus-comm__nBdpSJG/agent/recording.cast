[465.985555, "i", "cat > plus_comm.v << 'ENDOFFILE'\nRequire Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros n m.\ndestruct n.\n- case. intros m. simpl. reflexivity.\n- case. intros rest. intros m. simpl.\n  apply eq_refl.\nQed.\nENDOFFILE\n"]
