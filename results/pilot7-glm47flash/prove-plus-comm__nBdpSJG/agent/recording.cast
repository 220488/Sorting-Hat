[50.924241, "i", "cat > plus_comm.v << 'EOF'\nRequire Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros n m.\n  induction n as [|n IHn].\n  - case. (* Replace `simpl` with just `case` which doesn't change the goal *)\n    rewrite plus_n_O.\n    reflexivity.\n  - case.\n    rewrite Nat.add_0_r.\n    apply IHn.\nQed.\nEOF\n"]
