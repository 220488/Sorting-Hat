[255.203505, "i", "cat > plus_comm.v << 'EOF'\nRequire Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros x y.\n  apply nat_rect\n    with (P := fun _ => True).\n  - intros m. simpl. apply eq_refl.\n  - intros x y IH. \nQed.\nEOF\ncoqc plus_comm.v\n"]
