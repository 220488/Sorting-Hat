[191.110911, "i", "cat > debug_rewrite.v << 'EOF'\nFrom Coq Require Import Arith.\n\nGoal forall n m : nat, n + m = m + n.\nintros n m.\ninduction n as [|n IHn].\n- case. (* Switch to explicit case matching *)\n  intros m. simpl.\n  rewrite Nat.add_0_r.\n  reflexivity.\n- simpl.\n  apply IHn.\n  assumption.\nQed.\nEOF\ncoqc debug_rewrite.v\n"]
