[798.120126, "i", "printf 'Require Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros n m.\n  induction n as [|n IHn].\n  - intros m. simpl. symmetry. reflexivity.\n  - intros m. simpl. \n    apply nat_rect\n      with (fun m0 => n + m0 = m0 + n).\n    - reflexivity.\n    - apply IHn\nQed.' > plus_comm.v\n"]
[798.120557, "o", "printf 'Require Import Arith.\r\n\u001b[?2004l\r"]
