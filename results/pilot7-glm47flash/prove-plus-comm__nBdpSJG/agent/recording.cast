[451.252151, "o", "  intros n m.\r\n\u001b[?2004l\r\u001b[?2004h>   apply nat_ind\r\n\u001b[?2004l\r\u001b[?2004h>     with (m := m).\r\n\u001b[?2004l\r\u001b[?2004h>   - intros m. simpl. reflexivity.\r\n\u001b[?2004l\r\u001b[?2004h>   - intros n m IH. simpl.\r\n\u001b[?2004l\r\u001b[?2004h>     apply IH\r\n\u001b[?2004l\r\u001b[?2004h> Qed.\r\n\u001b[?2004l\r\u001b[?2004h> ENDOFFILE\r\n\u001b[?2004l\r"]
