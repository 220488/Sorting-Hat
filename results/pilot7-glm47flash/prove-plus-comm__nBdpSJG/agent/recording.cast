[238.954571, "i", "cat > plus_comm.v << 'EOF'\nRequire Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros n m.\n  apply nat_ind\n    with (m := m).\n  - simpl.\n    apply Nat.add_0_l.\n    apply Nat.add_0_r.\n  - intros n m IH. simpl.\n    apply IH.\nQed.\nEOF\ncoqc plus_comm.v\n"]
