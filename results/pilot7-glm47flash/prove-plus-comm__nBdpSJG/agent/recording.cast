[883.390434, "i", "printf 'Require Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros x y.\n  generalize dependent y.\n  induction x.\n  - intros y. simpl. reflexivity.\n  - intros y IH. simpl. symmetry. apply IH\nQed.' > plus_comm.v\n"]
[883.390587, "o", "printf 'Require Import Arith.\r\n"]
[883.390673, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
