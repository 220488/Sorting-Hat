[267.542226, "o", "nat_rect =\r\n\u001b[1mfun\u001b[0m (P : nat\u001b[37m ->\u001b[0m \u001b[33;1mType\u001b[0m) (f : P 0) (f0 : \u001b[1mforall\u001b[0m n : nat, P n\u001b[37m ->\u001b[0m P (S n)) =>\r\nfix F (n : nat) : P n :=\r\n  \u001b[1mmatch\u001b[0m n \u001b[1mas\u001b[0m n0 \u001b[1mreturn\u001b[0m (P n0) \u001b[1mwith\u001b[0m\r\n  | 0 => f\r\n  | S n0 => f0 n0 (F n0)\r\n  \u001b[1mend\u001b[0m\r\n     : \u001b[1mforall\u001b[0m P : nat\u001b[37m ->\u001b[0m \u001b[33;1mType\u001b[0m,\r\n       P 0\u001b[37m ->\u001b[0m (\u001b[1mforall\u001b[0m n : nat, P n\u001b[37m ->\u001b[0m P (S n))\u001b[37m ->\u001b[0m \u001b[1mforall\u001b[0m n : nat, P n\r\n\r\nArguments \u001b[92mnat_rect\u001b[0m P%function_scope f f0%function_scope n%nat_scope\r\n"]
[267.551383, "o", "\u001b[?2004hroot@54939701b0dc:/workspace# "]
[270.68516, "i", "cat > plus_comm.v << 'EOF'\nRequire Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros x y.\n  apply nat_rect\n    with (P := fun m => x + m = m + x).\n  - simpl. reflexivity.\n  - intros m IH x2. simpl.\n    apply eq_refl.\n    assumption\nQed.\nEOF\ncoqc plus_comm.v\n"]
