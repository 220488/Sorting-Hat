[236.134645, "i", "cat > plus_comm.v << 'EOF'\nRequire Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros n m.\n  induction n.\n  - intros m.\n    simpl.\n    rewrite Nat.add_0_r.\n    reflexivity.\n  - clear m. intros c IH. simpl.\n    rewrite Nat.add_0_r.\n    assumption\nQed.\nEOF\ncoqc plus_comm.v\n"]
