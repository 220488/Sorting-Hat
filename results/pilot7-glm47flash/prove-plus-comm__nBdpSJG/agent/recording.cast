[215.265324, "o", "    with (P := fun m => S (n + m) = m + S n).  \r\n\u001b[?2004l\r\u001b[?2004h>   - simpl.\r\n\u001b[?2004l\r\u001b[?2004h>     apply eq_refl.\r\n\u001b[?2004l\r\u001b[?2004h>   - simpl.\r\n\u001b[?2004l\r\u001b[?2004h> "]
