ILTER (!BOUND(?gradDate) || DATATYPE(?gradDate) != xsd:date || (?gradDate > \"2025-08-16\"^^xsd:date))\r\n    }\r\n    GROUP BY ?department\r\n  }\r\n  \r\n  # At least one department has more than 10 students\r\n  FILTER (?studentCount > 10)\r\n}\r\nGROUP BY ?professorName\r\n"]
