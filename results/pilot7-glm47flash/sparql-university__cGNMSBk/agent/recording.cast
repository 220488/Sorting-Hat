[9.051722, "o", "\u001b[?2004l\r\u001b[?2004h"]
[9.051739, "o", ">       ?student a uni:Person ;"]
[9.052686, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         uni:isEnrolledIn ?course .\r\n\u001b[?2004l\r\u001b[?2004h>       OPTIONAL { ?student uni:hasGraduationDate ?gradDate . }\r\n\u001b[?2004l\r\u001b[?2004h>       FILTER (!BOUND(?gradDate) || DATATYPE(?gradDate) != xsd:date || (?gradDate > \"2025-08-16\"^^xsd:date))\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     GROUP BY ?department\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   # At least one department has more than 10 students\r\n\u001b[?2004l\r\u001b[?2004h>   FILTER (?studentCount > 10)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> GROUP BY ?professorName\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
