[3.954212, "i", "cat > run.py <<'EOF'\nimport asyncio\nfrom typing import Callable, Awaitable, List\n\nasync def run_tasks(tasks: List[Callable[[], Awaitable[None]]], max_concurrent: int) -> None:\n    \"\"\"Run async tasks with a limit on concurrency.\n\n    Args:\n        tasks: A list of callables that return an awaitable (the async job).\n        max_concurrent: Maximum number of tasks to run at the same time.\n    \"\"\"\n    semaphore = asyncio.Semaphore(max_concurrent)\n\n    async def _run(task_callable: Callable[[], Awaitable[None]]) -> None:\n        async with semaphore:\n            # Await the task; any cleanup in the task's finally block will run\n            await task_callable()\n\n    # Prepare coroutines for all tasks\n    coros = [_run(t) for t in tasks]\n\n    # Run them, ensuring that cancellation still allows already started tasks to finish their cleanup.\n    try:\n        await asyncio.gather(*coros)\n    except asyncio.CancelledError:\n        # Propagate cancellation after awaiting all currently running tasks.\n        # asyncio.ga"]
[3.954395, "i", "ther will cancel pending tasks, but tasks already inside the semaphore will continue\n        # until they finish, allowing their finally blocks to run.\n        await asyncio.gather(*coros, return_exceptions=True)\n        raise\nEOF\n"]
[3.954443, "o", "cat > run.py <<'EOF'\r\n\u001b[?2004l\rther will cancel pending tasks, but tasks already inside the semaphore will continue\r\n        # until they finish, allowing their finally blocks to run.\r\n        await asyncio.gather(*coros, return_exceptions=True)\r\n        raise\r\nEOF\r\n"]
