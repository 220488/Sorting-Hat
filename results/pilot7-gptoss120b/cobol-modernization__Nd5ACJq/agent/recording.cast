[44.104042, "i", "cat > /app/program.py <<'PY'\n#!/usr/bin/env python3\nimport os, sys, shutil, tempfile\n\nBASE_DIR = '/app'\nDATA_DIR = os.path.join(BASE_DIR, 'data')\nSRC_DIR = os.path.join(BASE_DIR, 'src')\n\n# Fixed widths for the data files (as in COBOL)\nACCOUNT_ID_W = 4\nACCOUNT_NAME_W = 20\nACCOUNT_BAL_W = 10\nBOOK_ID_W = 4\nBOOK_TITLE_W = 20\nBOOK_OWNER_W = 4\nTRANS_BOOK_W = 4\nTRANS_AMT_W = 10\nTRANS_SELLER_W = 4\nTRANS_BUYER_W = 4\n\ndef pad_left_num(num, width):\n    return str(num).zfill(width)\n\ndef pad_right(s, width):\n    return s.ljust(width)[:width]\n\n# ---------- Read INPUT.DAT (flexible parsing) ----------\ninput_path = os.path.join(SRC_DIR, 'INPUT.DAT')\nif not os.path.exists(input_path):\n    print('Error: Input file not found')\n    sys.exit(1)\nwith open(input_path, 'rb') as f:  # binary to avoid newline handling issues\n    raw_bytes = f.read()\nraw = raw_bytes.decode('utf-8', errors='ignore')\nif len(raw) == 0:\n    print('Error: Input file is empty')\n    sys.exit(1)\n# Ensure we have at least the three IDs (12 chars)\nif len(raw) < "]
[44.104201, "i", "12:\n    print('Error: Input file malformed')\n    sys.exit(1)\nbuyer_id = raw[0:4]\nseller_id = raw[4:8]\nbook_id = raw[8:12]\namount_str = raw[12:].strip()  # remaining characters may be padded with spaces\nif amount_str == '':\n    amount = 0\nelse:\n    try:\n        amount = int(amount_str)\n    except ValueError:\n        print('Error: Invalid amount in input file')\n        sys.exit(1)\n\n# ---------- Validation ----------\nbuyer_found = seller_found = book_found = valid_owner = False\naccounts_path = os.path.join(DATA_DIR, 'ACCOUNTS.DAT')\nwith open(accounts_path, 'r') as f:\n    for line in f:\n        line = line.rstrip('\\n')\n        if len(line) < ACCOUNT_ID_W:\n            continue\n        acc_id = line[0:ACCOUNT_ID_W]\n        if acc_id == buyer_id:\n            buyer_found = True\n        if acc_id == seller_id:\n            seller_found = True\n        if buyer_found and seller_found:\n            break\n\nbooks_path = os.path.join(DATA_DIR, 'BOOKS.DAT')\nwith open(books_path, 'r') as f:\n    for line in f:\n        line = lin"]
[44.104214, "o", "cat > /app/program.py <<'PY'\r\n\u001b[?2004l\r"]
[44.10422, "i", "e.rstrip('\\n')\n        if len(line) < BOOK_ID_W:\n            continue\n        b_id = line[0:BOOK_ID_W]\n        if b_id == book_id:\n            book_found = True\n            owner = line[BOOK_ID_W + BOOK_TITLE_W:BOOK_ID_W + BOOK_TITLE_W + BOOK_OWNER_W]\n            if owner == seller_id:\n                valid_owner = True\n            break\n\nif not (buyer_found and seller_found and book_found and valid_owner):\n    print('Transaction failed due to validation errors')\n    sys.exit(0)\n\n# ---------- Process Transaction ----------\n# Update ACCOUNTS.DAT\ntemp_accounts = tempfile.NamedTemporaryFile('w', delete=False, dir=DATA_DIR)\nwith open(accounts_path, 'r') as src, temp_accounts:\n    for line in src:\n        orig = line.rstrip('\\n')\n        if len(orig) < ACCOUNT_ID_W + ACCOUNT_NAME_W + ACCOUNT_BAL_W:\n            temp_accounts.write(orig + '\\n')\n            continue\n        acc_id = orig[0:ACCOUNT_ID_W]\n        name = orig[ACCOUNT_ID_W:ACCOUNT_ID_W + ACCOUNT_NAME_W]\n        bal_str = orig[ACCOUNT_ID_W + ACCOUNT_NAME_"]
[44.105455, "o", "\u001b[?2004h> #!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> import os, sys, shutil, tempfile\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> BASE_DIR = '/app'\r\n\u001b[?2004l\r\u001b[?2004h> DATA_DIR = os.path.join(BASE_DIR, 'data')\r\n\u001b[?2004l\r\u001b[?2004h> SRC_DIR = os.path.join(BASE_DIR, 'src')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Fixed widths for the data files (as in COBOL)\r\n\u001b[?2004l\r\u001b[?2004h> ACCOUNT_ID_W = 4\r\n\u001b[?2004l\r\u001b[?2004h> ACCOUNT_NAME_W = 20\r\n\u001b[?2004l\r\u001b[?2004h> ACCOUNT_BAL_W = 10\r\n\u001b[?2004l\r\u001b[?2004h> BOOK_ID_W = 4\r\n\u001b[?2004l\r\u001b[?2004h> BOOK_TITLE_W = 20\r\n\u001b[?2004l\r\u001b[?2004h> BOOK_OWNER_W = 4\r\n\u001b[?2004l\r\u001b[?2004h> TRANS_BOOK_W = 4\r\n\u001b[?2004l\r\u001b[?2004h> TRANS_AMT_W = 10\r\n\u001b[?2004l\r\u001b[?2004h> TRANS_SELLER_W = 4\r\n\u001b[?2004l\r\u001b[?2004h> TRANS_BUYER_W = 4\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def pad_left_num(num, width):\r\n\u001b[?2004l\r\u001b[?2004h>     return str(num).zfill(width)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def pad_right(s, width):\r\n\u001b[?2004l\r\u001b[?2004h>     return s.ljust(width)[:width]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # -----"]
[44.10551, "i", "W:ACCOUNT_ID_W + ACCOUNT_NAME_W + ACCOUNT_BAL_W]\n        balance = int(bal_str)\n        if acc_id == buyer_id:\n            balance -= amount\n        if acc_id == seller_id:\n            balance += amount\n        new_bal = pad_left_num(balance, ACCOUNT_BAL_W)\n        temp_accounts.write(f\"{acc_id}{name}{new_bal}\\n\")\nshutil.move(temp_accounts.name, accounts_path)\n\n# Update BOOKS.DAT\ntemp_books = tempfile.NamedTemporaryFile('w', delete=False, dir=DATA_DIR)\nwith open(books_path, 'r') as src, temp_books:\n    for line in src:\n        orig = line.rstrip('\\n')\n        if len(orig) < BOOK_ID_W + BOOK_TITLE_W + BOOK_OWNER_W:\n            temp_books.write(orig + '\\n')\n            continue\n        b_id = orig[0:BOOK_ID_W]\n        title = orig[BOOK_ID_W:BOOK_ID_W + BOOK_TITLE_W]\n        owner = orig[BOOK_ID_W + BOOK_TITLE_W:BOOK_ID_W + BOOK_TITLE_W + BOOK_OWNER_W]\n        if b_id == book_id:\n            owner = buyer_id\n        temp_books.write(f\"{b_id}{title}{owner}\\n\")\nshutil.move(temp_books.name, books_path)\n\n# Append to"]
[44.105549, "o", "----- Read INPUT.DAT (flexible parsing) ----------\r\n\u001b[?2004l\r\u001b[?2004h> input_path = os.path.join(SRC_DIR, 'INPUT.DAT')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.105558, "i", " TRANSACTIONS.DAT\ntrans_path = os.path.join(DATA_DIR, 'TRANSACTIONS.DAT')\nwith open(trans_path, 'a') as f:\n    trans_book = pad_right(book_id, TRANS_BOOK_W)\n    trans_amt = pad_left_num(amount, TRANS_AMT_W)\n    trans_seller = pad_right(seller_id, TRANS_SELLER_W)\n    trans_buyer = pad_right(buyer_id, TRANS_BUYER_W)\n    f.write(f\"{trans_book}{trans_amt}{trans_seller}{trans_buyer}\\n\")\n\nprint('Transaction completed successfully')\nPY\n"]
