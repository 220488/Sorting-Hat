       if buyer_found and seller_found:\n            break\n\n# Validate book and ownership\nbooks_path = os.path.join(DATA_DIR, \'BOOKS.DAT\')\nwith open(books_path, \'r\') as f:\n    for line in f:\n        line = line.rstrip(\'\\n\')\n        if len(line) < BOOK_ID_W:\n            continue\n        b_id = line[0:BOOK_ID_W]\n        if b_id == book_id:\n            book_found = True\n            owner = line[BOOK_ID_W + BOOK_TITLE_W:BOOK_ID_W + BOOK_TITLE_W + BOOK_OWNER_W]\n            if owner == seller_id:\n                valid_owner = True\n            break\n\n# Decision\nif not (buyer_found and seller_found and book_found and valid_owner):\n    print(\'Transaction failed due to validation errors\')\n    sys.exit(0)\n\n# 3. Process transaction\n# ---- Update ACCOUNTS.DAT ----\ntemp_accounts = tempfile.NamedTemporaryFile(\'w\', delete=False, dir=DATA_DIR)\nwith open(accounts_path, \'r\') as src, temp_accounts:\n    for line in src:\n        orig_line = line.rstrip(\'\\n\')\n        if len(orig_line) < ACCOUNT_ID_W + ACCOUNT_NAME_W + ACCOUNT_BAL_W:\n            # keep malformed line as‑is\n            temp_accounts.write(orig_line + \'\\n\')\n            continue\n        acc_id = orig_line[0:ACCOUNT_ID_W]\n        name = orig_line[ACCOUNT_ID_W:ACCOUNT_ID_W + ACCOUNT_NAME_W]\n        bal_str = orig_line[ACCOUNT_ID_W + ACCOUNT_NAME_W:ACCOUNT_ID_W + ACCOUNT_NAME_W + ACCOUNT_BAL_W]\n        balance = int(bal_str)\n        if acc_id == buyer_id:\n            balance -= amount\n        if acc_id == seller_id:\n            balance += amount\n        new_bal = pad_left_num(balance, ACCOUNT_BAL_W)\n        new_line = f"{acc_id}{name}{new_bal}"\n        temp_accounts.write(new_line + \'\\n\')\nshutil.move(temp_accounts.name, accounts_path)\n\n# ---- Update BOOKS.DAT ----\nbooks_path = os.path.join(DATA_DIR, \'BOOKS.DAT\')\ntemp_books = tempfile.NamedTemporaryFile(\'w\', delete=False, dir=DATA_DIR)\nwith open(books_path, \'r\') as src, temp_books:\n    for line in src:\n