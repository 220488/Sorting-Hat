[25.402362, "o", "\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    uni:locatedInCountry \"DE\" .\r\r\n\u001b[32m\u001b[K42\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\r\n\u001b[32m\u001b[K43\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K# ---------------------------\r\r\n\u001b[32m\u001b[K44\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K# Departments\r\r\n\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K# ---------------------------\r\r\n\u001b[32m\u001b[K46\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kuni:\u001b[01;31m\u001b[KComputerScience_NTUA\u001b[m\u001b[K a uni:Department ;\r\r\n\u001b[32m\u001b[K47\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    uni:belongsTo uni:NTUA .\r\r\n\u001b[32m\u001b[K48\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\r\n\u001b[32m\u001b[K49\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kuni:MechEngineering_NTUA a uni:Department ;\r\r\n\u001b[32m\u001b[K50\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    uni:belongsTo uni:NTUA .\r\r\n\u001b[32m\u001b[K51\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K78\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\r\n\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K# ---------------------------\r\r\n\u001b[32m\u001b[K80\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K# Courses\r\r\n\u001b[32m\u001b[K81\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K# ---------------------------\r\r\n\u001b[32m\u001b[K82\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kuni:CS101 a uni:Course ;\r\r\n\u001b[32m\u001b[K83\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    uni:isTaughtIn uni:\u001b[01;31m\u001b[KComputerScience_NTUA\u001b[m\u001b[K .\r\r\n\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\r\n\u001b[32m\u001b[K85\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kuni:AI101 a uni:Course ;\r\r\