[?2004l[?2004h> 
[?2004l[?2004h> # EU member states (ISO‑3166‑1 alpha‑2) as of 2025‑08‑16
[?2004l[?2004h> VALUES ?euCountry {
[?2004l[?2004h>   "AT" "BE" "BG" "HR" "CY" "CZ" "DK" "EE" "FI" "FR"
[?2004l[?2004h>   "DE" "GR" "HU" "IE" "IT" "LV" "LT" "LU" "MT" "NL"
[?2004l[?2004h>   "PL" "PT" "RO" "SK" "SI" "ES" "SE" "EL" "LT" "LV"
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> SELECT ?professorName (GROUP_CONCAT(DISTINCT ?country; separator=", ") AS ?countries)
[?2004l[?2004h> WHERE {
[?2004l[?2004h>   # Full professors (role contains "Professor" but not "Assistant")
[?2004l[?2004h>   ?professor a uni:Person ;
[?2004l[?2004h>              uni:hasName ?professorName ;
[?2004l[?2004h>              uni:role ?role ;
[?2004l[?2004h>              uni:worksIn ?dept .
[?2004l[?2004h>   FILTER(CONTAINS(?role, "Professor") && !CONTAINS(?role, "Assistant"))
[?2004l[?2004h> 
[?2004l[?2004h>   # Department belongs to a university
[?2004l[?2004h>   ?dept a uni:Department ;
[?2004l[?2004h>         uni:belongsTo ?univ .
[?2004l[?2004h>   ?univ uni:locatedInCountry ?country .
[?2004l[?2004h>   FILTER(?country IN (?euCountry))
[?2004l[?2004h> 
[?2004l[?2004h>   # At least one of the professor's departments has >10 students enrolled in its courses
[?2004l[?2004h>   {
[?2004l[?2004h>     SELECT ?dept (COUNT(DISTINCT ?student) AS ?studentCount)
[?2004l[?2004h>     WHERE {
[?2004l[?2004h>       ?course a uni:Course ;
[?2004l[?2004h>               uni:isTaughtIn ?dept .
[?2004l[?2004h>       ?student a uni:Person ;
[?2004l[?2004h>                uni:role "Student" ;
[?2004l[?2004h>                uni:isEnrolledIn ?course .
[?2004l[?2004h>     }
[?2004l[?2004h>     GROUP BY ?dept
[?2004l[?2004h>     HAVING(?studentCount > 10)
[?2004l[?2004h>   }
[?2004l[?2004h> }
[?2004l[?2004h> GROUP BY ?professorName
[?2004l[?2004h> EOF
