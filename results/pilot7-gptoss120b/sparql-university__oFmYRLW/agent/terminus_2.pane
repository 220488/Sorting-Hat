[?2004hroot@659d37762bc7:/app# cat <<'EOF' > /app/solution.sparql
[?2004l[?2004h> PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
[?2004l[?2004h> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
[?2004l[?2004h> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
[?2004l[?2004h> PREFIX uni: <http://example.org/university#>
[?2004l[?2004h> 
[?2004l[?2004h> # List of EU member state ISO codes as of 2025-08-16
[?2004l[?2004h> VALUES ?euCountry {
[?2004l[?2004h>   "AT" "BE" "BG" "HR" "CY" "CZ" "DK" "EE" "FI" "FR"
[?2004l[?2004h>   "DE" "GR" "HU" "IE" "IT" "LV" "LT" "LU" "MT" "NL"
[?2004l[?2004h>   "PL" "PT" "RO" "SK" "SI" "ES" "SE" "NL" "EL" "LU"
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> SELECT ?professorName (GROUP_CONCAT(DISTINCT ?country; separator=", ") AS ?countries)
[?2004l[?2004h> WHERE {
[?2004l[?2004h>   # Identify full professors
[?2004l[?2004h>   ?professor a uni:FullProfessor .
[?2004l[?2004h>   ?professor uni:hasName ?professorName .
[?2004l[?2004h> 
[?2004l[?2004h>   # Professors work in departments
[?2004l[?2004h>   ?professor uni:worksIn ?dept .
[?2004l[?2004h> 
[?2004l[?2004h>   # Department belongs to a university
[?2004l[?2004h>   ?dept uni:partOf ?univ .
[?2004l[?2004h> 
[?2004l[?2004h>   # University is located in a country (ISO code as string)
[?2004l[?2004h>   ?univ uni:locatedInCountry ?country .
[?2004l[?2004h>   FILTER(?country IN (?euCountry))
[?2004l[?2004h> 
[?2004l[?2004h>   # Ensure at least one department (could be the same ?dept) has >10 students enrolled in its classes
[?2004l[?2004h>   {
[?2004l[?2004h>     SELECT ?dept (COUNT(DISTINCT ?student) AS ?studentCount)
[?2004l[?2004h>     WHERE {
[?2004l[?2004h>       ?dept a uni:Department .
[?2004l[?2004h>       # Classes taught by the department (or by professors in that department)
[?2004l[?2004h>       ?class uni:taughtBy ?professor .
[?2004l[?2004h>       ?class uni:belongsToDepartment ?dept .
[?2004l[?2004h>       # Enrolled students
[?2004l[?2004h>       ?class uni:hasEnrolledStudent ?student .
[?2004l[?2004h>     }
[?2004l[?2004h>     GROUP BY ?dept
[?2004l[?2004h>     HAVING (?studentCount > 10)
[?2004l[?2004h>   }
[?2004l[?2004h> }
[?2004l[?2004h> GROUP BY ?professorName
[?2004l[?2004h> EOF
