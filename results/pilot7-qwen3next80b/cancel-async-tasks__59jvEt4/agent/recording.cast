[5.321677, "o", "import asyncio\r\n\r\nasync def run_tasks(tasks: list[callable[[], asyncio.Future[None]]], max_concurrent: int) -> None:\r\n    semaphore = asyncio.Semaphore(max_concurrent)\r\n    \r\n    async def bounded_task(task):\r\n        async with semaphore:\r\n            try:\r\n                await task()\r\n            finally:\r\n                # Cleanup code will execute even if interrupted\r\n                pass\r\n    \r\n    await asyncio.gather(*(bounded_task(task) for task in tasks))\r\n"]
