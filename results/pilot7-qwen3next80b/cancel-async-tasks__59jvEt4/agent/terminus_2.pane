[?2004limport asyncio

async def run_tasks(tasks: list[callable[[], asyncio.Future[None]]], max_concurrent: int) -> None:
    semaphore = asyncio.Semaphore(max_concurrent)
    
    async def bounded_task(task):
        async with semaphore:
            try:
                await task()
            finally:
                # Cleanup code will execute even if interrupted
                pass
    
    await asyncio.gather(*(bounded_task(task) for task in tasks))
