[?2004l[?2004h>             book["title"].ljust(20).encode('ascii') +
[?2004l[?2004h>             book["owner"].ljust(4).encode('ascii')
[?2004l[?2004h>         )
[?2004l[?2004h>         updated_books_data += record
[?2004l[?2004h> 
[?2004l[?2004h>     # Append transaction to TRANSACTIONS.DAT
[?2004l[?2004h>     transaction_record = (
