[?2004l[?2004h> import struct
[?2004l[?2004h> 
[?2004l[?2004h> # Read INPUT.DAT (20-byte fixed record)
[?2004l[?2004h> with open('/app/src/INPUT.DAT', 'rb') as f:
[?2004l[?2004h>     data = f.read(20)
[?2004l[?2004h>     buyer_id = data[0:4].decode('ascii').strip()
[?2004l[?2004h>     seller_id = data[4:8].decode('ascii').strip()
[?2004l[?2004h>     book_id = data[8:12].decode('ascii').strip()
[?2004l[?2004h>     amount = int(data[12:22].decode('ascii'))  # 10-digit integer (no decimal)
[?2004l[?2004h> 
[?2004l[?2004h> # Define record sizes
[?2004l[?2004h> ACCOUNT_REC_SIZE = 34  # 4 + 20 + 10
[?2004l[?2004h> BOOK_REC_SIZE = 28     # 4 + 20 + 4
[?2004l[?2004h> TRANS_REC_SIZE = 28    # 4 + 10 + 4 + 4
[?2004l[?2004h> 
[?2004l[?2004h> # Read all accounts
[?2004l[?2004h> accounts = []
[?2004l[?2004h> with open('/app/data/ACCOUNTS.DAT', 'rb') as f:
[?2004l[?2004h>     while True:
[?2004l[?2004h>         record = f.read(ACCOUNT_REC_SIZE)
[?2004l[?2004h>         if not record:
[?2004l[?2004h>             break
[?2004l[?2004h>         acct_id = record[0:4].decode('ascii').strip()
[?2004l[?2004h>         acct_name = record[4:24].decode('ascii').strip()
[?2004l[?2004h>         balance = int(record[24:34].decode('ascii'))
[?2004l[?2004h>         accounts.append({"id": acct_id, "name": acct_name, "balance": balance})
[?2004l[?2004h> 
[?2004l[?2004h> # Read all books
[?2004l[?2004h> books = []
[?2004l[?2004h> with open('/app/data/BOOKS.DAT', 'rb') as f:
[?2004l[?2004h>     while True:
[?2004l[?2004h>         record = f.read(BOOK_REC_SIZE)
[?2004l[?2004h>         if not record:
[?2004l[?2004h>             break
[?2004l[?2004h>         book_id_in_file = record[0:4].decode('ascii').strip()
[?2004l[?2004h>         title = record[4:24].decode('ascii').strip()
[?2004l[?2004h>         owner = record[24:28].decode('ascii').strip()
[?2004l[?2004h>         books.append({"id": book_id_in_file, "title": title, "owner": owner})
[?2004l[?2004h> 
[?2004l[?2004h> # Validate
[?2004l[?2004h> buyer_found = any(acc["id"] == buyer_id for acc in accounts)
[?2004l[?2004h> seller_found = any(acc["id"] == seller_id for acc in accounts)
[?2004l[?2004h> book_found = any(b["id"] == book_id for b in books)
[?2004l[?2004h> valid_owner = any(b["id"] == book_id and b["owner"] == seller_id for b in books)
[?2004l[?2004h> 
[?2004l[?2004h> if not (buyer_found and seller_found and book_found and valid_owner):
[?2004l[?2004h>     print("Transaction failed due to validation errors")
[?2004l[?2004h> else:
[?2004l[?2004h>     # Update accounts: subtract from buyer, add to seller
[?2004l[?2004h>     for acc in accounts:
[?2004l[?2004h>         if acc["id"] == buyer_id:
[?2004l[?2004h>             acc["balance"] -= amount
[?2004l[?2004h>         elif acc["id"] == seller_id:
[?2004l[?2004h>             acc["balance"] += amount
[?2004l[?2004h> 
[?2004l[?2004h>     # Update book owner
[?2004l[?2004h>     for book in books:
[?2004l[?2004h>         if book["id"] == book_id:
[?2004l[?2004h>             book["owner"] = buyer_id
[?2004l[?2004h> 
[?2004l[?2004h>     # Build updated ACCOUNTS.DAT content
[?2004l[?2004h>     updated_accounts_data = b""
[?2004l[?2004h>     for acc in accounts:
[?2004l[?2004h>         record = (
[?2004l[?2004h>             acc["id"].ljust(4).encode('ascii') +
[?2004l[?2004h>             acc["name"].ljust(20).encode('ascii') +
[?2004l[?2004h>             str(acc["balance"]).rjust(10, '0').encode('ascii')
[?2004l[?2004h>         )
[?2004l[?2004h>         updated_accounts_data += record
[?2004l[?2004h> 
[?2004l[?2004h>     # Build updated BOOKS.DAT content
[?2004l[?2004h>     updated_books_data = b""
[?2004l[?2004h>     for book in books:
