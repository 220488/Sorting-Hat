[8.989059, "o", "PREFIX dbr: <http://dbpedia.org/resource/>\r\n\u001b[?2004l\r\u001b[?2004h> PREFIX : <http://example.org/university#>\r\n\u001b[?2004l\r"]
[8.989075, "o", "\u001b[?2004h> \r\n"]
